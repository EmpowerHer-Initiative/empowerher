{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "empowerher",
  "compatibility_date": "2026-09-17",
  // react-email / resend pull in node builtins (stream, buffer) at runtime.
  "compatibility_flags": ["nodejs_compat"],
  // Prerendered pages + assets served straight from the edge; the Worker only
  // runs for the SSR /api/* form endpoints.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
