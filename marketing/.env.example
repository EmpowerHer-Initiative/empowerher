# ── Email provider ──
# Server-only — used by the /api/contact, /api/partner, /api/volunteer routes.
# Set ONE of the two API keys. If both are set, Resend wins.
# Handover: create your own account and swap the key — no code changes needed.

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""

# useSend — API key from the useSend dashboard; USESEND_URL is the base URL of
# a self-hosted instance (defaults to https://app.usesend.com when empty).
USESEND_API_KEY=""
USESEND_URL=""

# Where contact, partner, and volunteer messages are delivered.
CONTACT_EMAIL="info@empowerher-initiative.org"

# Optional — defaults to "EmpowerHer <no-reply@alisamadii.com>".
# EMAIL_FROM="EmpowerHer <no-reply@empowerher-initiative.org>"
