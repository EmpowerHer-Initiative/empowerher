---
import Layout from "../layouts/Layout.astro";
import Header from "../components/marketing/sisterhood-sessions/Header.astro";
import WhyTheyMatter from "../components/marketing/sisterhood-sessions/WhyTheyMatter.astro";
import Community from "../components/marketing/sisterhood-sessions/Community.astro";
import SessionFormat from "../components/marketing/sisterhood-sessions/SessionFormat.astro";
import pages from "../data/pages.json";
const content = pages["sisterhood-sessions"];

const { seo, header, whyTheyMatter, community, sessionFormat } = content;
---

<Layout title={seo.title} description={seo.description}>
  <Header cmsPath="header" {...header} />
  <WhyTheyMatter cmsPath="whyTheyMatter" {...whyTheyMatter} />
  <Community cmsPath="community" {...community} />
  <SessionFormat cmsPath="sessionFormat" {...sessionFormat} />
</Layout>
