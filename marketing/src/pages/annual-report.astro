---
import Layout from "../layouts/Layout.astro";
import Header from "../components/marketing/annual-report/Header.astro";
import ReportCard from "../components/marketing/annual-report/ReportCard.astro";
import pages from "../data/pages.json";
const content = pages["annual-report"];

const { seo, header, reportCard } = content;
---

<Layout title={seo.title} description={seo.description}>
  <Header {...header} cmsPath="header" />
  <ReportCard {...reportCard} cmsPath="reportCard" />
</Layout>
