---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/marketing/spr/Hero.astro";
import Eligibility from "../../components/marketing/spr/Eligibility.astro";
import StepByStep from "../../components/marketing/spr/StepByStep.astro";
import Benefits from "../../components/marketing/spr/Benefits.astro";
import pages from "../../data/pages.json";
const data = pages.spr;

const { seo, hero, eligibility, stepByStep, benefits } = data;
---

<Layout title={seo.title} description={seo.description}>
  <Hero cmsPath="hero" {...hero} />
  <Eligibility cmsPath="eligibility" {...eligibility} />
  <StepByStep cmsPath="stepByStep" {...stepByStep} />
  <Benefits cmsPath="benefits" {...benefits} />
</Layout>
