---
// Ports app/(marketing)/success-stories/page.tsx
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/marketing/success-stories/Header.astro";
import Stories from "../../components/marketing/success-stories/Stories.astro";
import ClosingCTA from "../../components/marketing/success-stories/ClosingCTA.astro";
import data from "../../data/success-stories.json";

const { seo, header, stories, closingCta } = data;
---
<Layout title={seo.title} description={seo.description}>
  <Header {...header} />
  <Stories stories={stories} />
  <ClosingCTA {...closingCta} />
</Layout>
