---
// Ports app/(marketing)/success-stories/page.tsx
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/marketing/success-stories/Header.astro";
import Stories from "../../components/marketing/success-stories/Stories.astro";
import ClosingCTA from "../../components/marketing/success-stories/ClosingCTA.astro";
import pages from "../../data/pages.json";
const data = pages["success-stories"];
import { impactStories } from "../../lib/collections";

const { seo, header, closingCta } = data;
---
<Layout title={seo.title} description={seo.description}>
  <Header {...header} cmsPath="header" />
  <Stories stories={impactStories} />
  <ClosingCTA {...closingCta} cmsPath="closingCta" />
</Layout>
