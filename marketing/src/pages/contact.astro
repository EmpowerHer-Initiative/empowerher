---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/marketing/contact/ContactForm.astro";
import content from "../data/contact.json";

const { seo, eyebrow, heading, intro, email, location, followUsTitle } =
  content;
---

<Layout title={seo.title} description={seo.description}>
  <ContactForm
    eyebrow={eyebrow}
    heading={heading}
    intro={intro}
    email={email}
    location={location}
    followUsTitle={followUsTitle}
    cmsPath=""
  />
</Layout>
