---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/marketing/legal/Hero.astro";
import LegalBody from "../components/marketing/legal/LegalBody.astro";
import pages from "_pages.json";
const content = pages.legal;

interface Part {
  eyebrow: string;
  title: string;
  paragraphs: string[];
}

const { hero, body } = content as {
  seo: { title: string; description: string };
  hero: {
    eyebrow: string;
    heading: string;
    body: string;
  };
  body: {
    parts: Part[];
    footer: { updated: string; contactPrompt: string; email: string };
  };
};
---

<Layout>
  <main>
    <Hero eyebrow={hero.eyebrow} heading={hero.heading} body={hero.body} />
    <LegalBody parts={body.parts} footer={body.footer} />
  </main>
</Layout>
