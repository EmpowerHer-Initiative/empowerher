---
import Layout from "../layouts/Layout.astro";
import NewsletterForm from "../components/marketing/newsletter/NewsletterForm.astro";
import pages from "../data/pages.json";
const content = pages.newsletter;

const { seo, eyebrow, heading, subheading, image, overlay } = content;
---

<Layout>
  <NewsletterForm
    eyebrow={eyebrow}
    heading={heading}
    subheading={subheading}
    image={image}
    overlay={overlay}
    cmsPath=""
  />
</Layout>
