---
import Layout from "../layouts/Layout.astro";
import Header from "../components/marketing/resources/Header.astro";
import ResourceList from "../components/marketing/resources/ResourceList.astro";
import FooterNote from "../components/marketing/resources/FooterNote.astro";
import data from "../data/resources.json";

const { seo, header, resources, footerNote } = data;
---

<Layout title={seo.title} description={seo.description}>
  <Header eyebrow={header.eyebrow} heading={header.heading} intro={header.intro} cmsPath="header" />
  <ResourceList resources={resources} cmsPath="resources" />
  <FooterNote text={footerNote.text} email={footerNote.email} cmsPath="footerNote" />
</Layout>
