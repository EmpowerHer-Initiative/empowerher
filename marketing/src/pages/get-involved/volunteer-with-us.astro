---
import Layout from "../../layouts/Layout.astro";
import VolunteerContact from "../../components/marketing/get-involved/VolunteerContact.astro";
import data from "../../data/get-involved-volunteer.json";
---
<Layout title={data.seo.title} description={data.seo.description}>
