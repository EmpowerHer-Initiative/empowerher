---
import Layout from "../../layouts/Layout.astro";
import VolunteerContact from "../../components/marketing/get-involved/VolunteerContact.astro";
import pages from "../../data/pages.json";
const data = pages["get-involved-volunteer"];
---
<Layout title={data.seo.title} description={data.seo.description}>
  <VolunteerContact
    eyebrow={data.eyebrow}
    heading={data.heading}
    body={data.body}
    note={data.note}
    questions={data.questions}
    cmsPath=""
  />
</Layout>
