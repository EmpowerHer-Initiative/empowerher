---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/marketing/writing-contest/Hero.astro";
import AboutContest from "../components/marketing/writing-contest/AboutContest.astro";
import WritingPrompt from "../components/marketing/writing-contest/WritingPrompt.astro";
import WhoCanParticipate from "../components/marketing/writing-contest/WhoCanParticipate.astro";
import SubmissionRequirements from "../components/marketing/writing-contest/SubmissionRequirements.astro";
import HowToSubmit from "../components/marketing/writing-contest/HowToSubmit.astro";
import Deadlines from "../components/marketing/writing-contest/Deadlines.astro";
import Awards from "../components/marketing/writing-contest/Awards.astro";
import Judges from "../components/marketing/writing-contest/Judges.astro";
import pages from "../data/pages.json";
const data = pages["writing-contest"];
---

<Layout>
  <Hero {...data.hero} cmsPath="hero" />
  <AboutContest {...data.aboutContest} cmsPath="aboutContest" />
  <WritingPrompt {...data.writingPrompt} cmsPath="writingPrompt" />
  <WhoCanParticipate {...data.whoCanParticipate} cmsPath="whoCanParticipate" />
  <SubmissionRequirements {...data.submissionRequirements} cmsPath="submissionRequirements" />
  <HowToSubmit {...data.howToSubmit} cmsPath="howToSubmit" />
  <Deadlines {...data.deadlines} cmsPath="deadlines" />
  <Awards {...data.awards} cmsPath="awards" />
  <Judges {...data.judges} cmsPath="judges" />
</Layout>
