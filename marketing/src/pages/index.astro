---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/marketing/home/Hero.astro";
import StatsBar from "../components/marketing/home/StatsBar.astro";
import HerVoiceContest from "../components/marketing/home/HerVoiceContest.astro";
import AtAGlance from "../components/marketing/home/AtAGlance.astro";
import Mission from "../components/marketing/home/Mission.astro";
import Programs from "../components/marketing/home/Programs.astro";
import ImpactStory from "../components/marketing/home/ImpactStory.astro";
import MediaSpotlight from "../components/marketing/home/MediaSpotlight.astro";
import Partners from "../components/marketing/home/Partners.astro";
import Newsletter from "../components/marketing/home/Newsletter.astro";
import pages from "../data/pages.json";
const content = pages.home;
import { partners } from "../lib/collections";
---

<Layout>
  <Hero cmsPath="hero" {...content.hero} />
  <StatsBar cmsPath="statsBar" {...content.statsBar} />
  <HerVoiceContest cmsPath="herVoiceContest" {...content.herVoiceContest} />
  <AtAGlance cmsPath="atAGlance" {...content.atAGlance} />
  <Mission cmsPath="mission" {...content.mission} />
  <Programs cmsPath="programs" {...content.programs} />
  <ImpactStory cmsPath="impactStory" {...content.impactStory} />
  <MediaSpotlight cmsPath="mediaSpotlight" {...content.mediaSpotlight} />
  <Partners cmsPath="partners" eyebrow={content.partners.eyebrow} partners={partners} />
  <Newsletter cmsPath="newsletter" {...content.newsletter} />
</Layout>
