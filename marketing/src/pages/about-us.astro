---
import Layout from "../layouts/Layout.astro";
import { partners, teamMembers, TEAM_BANDS } from "../lib/collections";

// Team members are a flat CMS collection; regroup into the fixed display bands.
const teamGroups = TEAM_BANDS.map((label) => ({
  label,
  members: teamMembers.filter((m) => m.group === label),
}));
import Hero from "../components/marketing/about-us/Hero.astro";
import MissionVision from "../components/marketing/about-us/MissionVision.astro";
import OurStory from "../components/marketing/about-us/OurStory.astro";
import WhatWeDo from "../components/marketing/about-us/WhatWeDo.astro";
import Team from "../components/marketing/about-us/Team.astro";
import Partners from "../components/marketing/Partners.astro";
import CTA from "../components/marketing/about-us/CTA.astro";
---

<Layout>
  <Hero />
  <MissionVision />
  <OurStory />
  <WhatWeDo />
  <Team groups={teamGroups} />
  <Partners partners={partners} />
  <CTA />
</Layout>
