---
import Layout from "../layouts/Layout.astro";
import AgfafContent from "../components/marketing/agfaf/AgfafContent.astro";
import agfaf from "../data/agfaf.json";
---

<Layout title={agfaf.seo.title} description={agfaf.seo.description}>
