---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import cms from "../data/cms.json";
import seo from "../data/seo.json";
import variables from "../data/variables.json";

interface Props {
  /** Overrides the seo.json title for this route (e.g. dynamic pages). */
  title?: string;
  /** Overrides the seo.json description for this route. */
  description?: string;
  /** Absolute URL of the social share image. Defaults to seo.json ogImage. */
  image?: string;
  /** Alt text for the share image. */
  imageAlt?: string;
  /** og:type — "website" for pages, "article" for blog stories. */
  type?: "website" | "article";
  /** ISO date (YYYY-MM-DD) for articles → article:published_time. */
  publishedTime?: string;
}

// Resolve the seo.json page slice by matching the current path to a cms.json
// route (both normalized without a trailing slash).
const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const here = norm(Astro.url.pathname);
const pageKey = Object.keys(cms.pages).find(
  (k) => norm((cms.pages as Record<string, { route: string }>)[k].route) === here,
);
const pageSeo = (pageKey && seo.pages[pageKey as keyof typeof seo.pages]) || null;

const SITE_NAME = seo.site.title || variables.name;

// Precedence: explicit prop → per-page seo.json → site default.
const {
  title = pageSeo?.title || seo.site.title || SITE_NAME,
  description = pageSeo?.description || seo.site.description,
  image,
  imageAlt = `${variables.name} logo`,
  type = "website",
  publishedTime,
} = Astro.props;

// Astro.site comes from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogPath =
  image ?? (pageSeo?.ogImage || seo.site.ogImage || "/og-image.png");
const ogImage = new URL(ogPath, Astro.site).href;
const favicon = seo.site.favicon || "/favicon.ico";
const appleTouchIcon = seo.site.appleTouchIcon || "/apple-touch-icon.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NGO",
      "@id": `${Astro.site?.href}#organization`,
      name: variables.name,
      url: Astro.site?.href,
      logo: {
        "@type": "ImageObject",
        url: variables.logo,
      },
      description: seo.site.description,
      email: variables.email,
      sameAs: variables.socials.map((s) => s.url),
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site?.href}#website`,
      url: Astro.site?.href,
      name: variables.name,
      alternateName: "EmpowerHer",
      description: seo.site.description,
      publisher: { "@id": `${Astro.site?.href}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={favicon} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5ba8d8" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@200..800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={SITE_NAME} />
    {type !== "article" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {seo.site.googleAnalytics && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${seo.site.googleAnalytics}`}
        />
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${seo.site.googleAnalytics}');`} />
      </>
    )}
    <ClientRouter />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
