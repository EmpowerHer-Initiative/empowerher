{
  "version": 1,
  "baseUrl": "https://www.empowerher-initiative.org",
  "media": {
    "input": "public/media",
    "output": "/media"
  },
  "pages": {
    "home": {
      "route": "/"
    },
    "about-us": {
      "route": "/about-us"
    },
    "writing-contest": {
      "route": "/writing-contest"
    },
    "mentorship": {
      "route": "/mentorship"
    },
    "sisterhood-sessions": {
      "route": "/sisterhood-sessions"
    },
    "hervoice": {
      "route": "/hervoice/",
      "title": "HerVoice"
    },
    "hervoice-winners": {
      "route": "/hervoice/winners",
      "title": "HerVoice Winners"
    },
    "hervoice-featured-writings": {
      "route": "/hervoice/featured-writings-from-our-partners",
      "title": "Featured Writings"
    },
    "success-stories": {
      "route": "/success-stories/",
      "title": "Success Stories"
    },
    "spr": {
      "route": "/success-stories/spr",
      "title": "Student Project Roadmap"
    },
    "get-involved": {
      "route": "/get-involved/",
      "title": "Get Involved"
    },
    "get-involved-partner": {
      "route": "/get-involved/partner-with-us",
      "title": "Partner With Us"
    },
    "get-involved-volunteer": {
      "route": "/get-involved/volunteer-with-us",
      "title": "Volunteer With Us"
    },
    "agfaf": {
      "route": "/agfaf",
      "title": "AGFAF"
    },
    "annual-report": {
      "route": "/annual-report"
    },
    "resources": {
      "route": "/resources"
    },
    "mis": {
      "route": "/mis"
    },
    "newsletter": {
      "route": "/newsletter"
    },
    "contact": {
      "route": "/contact"
    },
    "legal": {
      "route": "/legal"
    },
    "privacy": {
      "route": "/privacy"
    },
    "terms": {
      "route": "/terms"
    }
  },
  "collections": [
    {
      "name": "hervoice-stories",
      "label": "HerVoice Stories",
      "path": "src/content/hervoice",
      "route": "/hervoice/{slug}",
      "fields": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "label": "Title"
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description"
        },
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Cover image"
        },
        {
          "name": "imageAlt",
          "type": "string",
          "label": "Image alt / caption"
        },
        {
          "name": "imageCredit",
          "type": "string",
          "label": "Image credit"
        },
        {
          "name": "date",
          "type": "date",
          "required": true,
          "label": "Date"
        },
        {
          "name": "hideFromListing",
          "type": "boolean",
          "label": "Hide from the HerVoice listing"
        },
        {
          "name": "authorName",
          "type": "string",
          "label": "Author name"
        },
        {
          "name": "authorPosition",
          "type": "string",
          "label": "Author position"
        },
        {
          "name": "authorBio",
          "type": "text",
          "label": "Author bio"
        },
        {
          "name": "authorInstagram",
          "type": "string",
          "label": "Author Instagram"
        },
        {
          "name": "authorFacebook",
          "type": "string",
          "label": "Author Facebook"
        },
        {
          "name": "authorLinkedin",
          "type": "string",
          "label": "Author LinkedIn"
        },
        {
          "name": "messageToWorld",
          "type": "text",
          "label": "Message to the world"
        }
      ]
    },
    {
      "name": "featured-writings",
      "label": "Featured Writings",
      "path": "src/data/collections/featured-writings.json",
      "fields": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "label": "Title"
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description"
        },
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Image"
        },
        {
          "name": "link",
          "type": "string",
          "label": "Link"
        },
        {
          "name": "from",
          "type": "string",
          "label": "Platform"
        }
      ]
    },
    {
      "name": "impact-stories",
      "label": "Success Stories",
      "path": "src/data/collections/impact-stories.json",
      "fields": [
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Logo image"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "label": "Title"
        },
        {
          "name": "subtitle",
          "type": "string",
          "label": "Subtitle"
        },
        {
          "name": "date",
          "type": "string",
          "label": "Date"
        },
        {
          "name": "badge",
          "type": "string",
          "label": "Badge"
        },
        {
          "name": "intro",
          "type": "text",
          "label": "Intro paragraph"
        },
        {
          "name": "afterQuote",
          "type": "text",
          "label": "Paragraph after quote"
        }
      ]
    },
    {
      "name": "partners",
      "label": "Partners",
      "path": "src/data/collections/partners.json",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "label": "Name"
        },
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Logo"
        },
        {
          "name": "link",
          "type": "string",
          "label": "Link"
        }
      ]
    },
    {
      "name": "resource-listings",
      "label": "Resources",
      "path": "src/data/collections/resource-listings.json",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "label": "Name"
        },
        {
          "name": "location",
          "type": "string",
          "label": "Location"
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description"
        },
        {
          "name": "link",
          "type": "string",
          "label": "Link"
        },
        {
          "name": "image",
          "type": "image",
          "label": "Logo"
        }
      ]
    },
    {
      "name": "team",
      "label": "Team Members",
      "path": "src/data/collections/team.json",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "label": "Name"
        },
        {
          "name": "role",
          "type": "string",
          "label": "Role / title"
        },
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Photo"
        },
        {
          "name": "group",
          "type": "select",
          "required": true,
          "label": "Group",
          "options": [
            "Executive Team",
            "Directors",
            "Mentors & Lecturers"
          ]
        }
      ]
    },
    {
      "name": "workshops",
      "label": "Workshops",
      "path": "src/data/collections/workshops.json",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "label": "Name"
        },
        {
          "name": "mentors",
          "type": "string",
          "label": "Mentors"
        },
        {
          "name": "description",
          "type": "text",
          "label": "Description"
        },
        {
          "name": "image",
          "type": "image",
          "required": true,
          "label": "Image"
        },
        {
          "name": "link",
          "type": "string",
          "label": "Application link"
        }
      ]
    }
  ]
}
