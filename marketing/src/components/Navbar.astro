---
// Ports components/navbar.tsx. Home page: transparent over the hero, solidifies
// on scroll. Desktop dropdowns are CSS hover; mobile menu + scroll state are JS.
import Logo from "./icons/Logo.astro";
import ChevronDown from "./icons/ChevronDown.astro";
import variables from "../data/variables.json";
import { Region } from "@alisamadiillc/cms-bridge/components";

// Nav links + CTA are hardcoded here (not CMS-managed). The brand name is the
// global identity from variables.json. Active-tab ownership (data-paths) is
// derived from each link's own href plus its descendants'.
interface NavItem {
  label: string;
  link: string;
  children?: NavItem[];
}

const navCta = { label: "Get Involved", link: "/get-involved" };

const navItems: NavItem[] = [
  { label: "About", link: "/about-us" },
  {
    label: "Programs",
    link: "#",
    children: [
      {
        label: "Mentorship Program",
        link: "/mentorship",
        children: [
          { label: "Monthly Internet Scholarship (MIS)", link: "/mis" },
          { label: "Student Project Roadmap", link: "/success-stories/spr" },
        ],
      },
      {
        label: "HerVoice",
        link: "/hervoice",
        children: [
          {
            label: "Featured Writings from Our Partners",
            link: "/hervoice/featured-writings-from-our-partners",
          },
        ],
      },
    ],
  },
  { label: "Success Stories", link: "/success-stories" },
  { label: "Resources", link: "/resources" },
  { label: "AGFAF", link: "/agfaf" },
  { label: "Contact", link: "/contact" },
];

const [nameFirst, ...nameRestParts] = variables.name.split(" ");
const nameRest = nameRestParts.join(" ");

const collectPaths = (item: NavItem): string[] =>
  [item.link, ...(item.children ?? []).flatMap(collectPaths)].filter(
    (p) => p && p !== "#",
  );

const navLinks = navItems.map((item) => ({
  ...item,
  paths: collectPaths(item),
}));

const isHome = Astro.url.pathname === "/";
---

<nav
  id="site-nav"
  transition:persist="site-nav"
  class:list={["site-nav", { home: isHome }]}
  data-state={isHome ? "top" : "scrolled"}
>
  <div class="container flex h-16 items-center justify-between lg:h-20">
    <a
      href="/"
      class="nav-brand flex items-center gap-2 transition-colors duration-300"
    >
      <Logo class="size-12" />
      <Region type="variant" variantName="name">
        <span class="font-serif text-xl leading-[1]"
          >{nameFirst}<br class="md:hidden" /> {nameRest}</span
        >
      </Region>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {
        navLinks.map((link, i) => (
          <div class="group relative">
            {link.children?.length ? (
              <button
                data-paths={link.paths.join(" ")}
                class="nav-link flex items-center gap-1 text-[13px] font-medium transition-colors duration-300"
              >
                <span>{link.label}</span>
                <ChevronDown class="size-3 transition-transform duration-300 group-hover:rotate-180" />
              </button>
            ) : (
              <a
                href={link.link}
                data-paths={link.paths.join(" ")}
                class="nav-link text-[13px] font-medium transition-colors duration-300"
              >
                <span>{link.label}</span>
              </a>
            )}

            {!!link.children?.length && (
              <div class="dropdown absolute top-full left-1/2 z-50 pt-4 transition-all duration-[400ms] ease-[cubic-bezier(0.32,0.72,0,1)]">
                <div class="border-border/50 bg-background/95 shadow-dropdown min-w-[280px] rounded-2xl border p-1.5 backdrop-blur-xl">
                  {link.children.map((child, ci) =>
                    child.children?.length ? (
                      <div>
                        <a
                          href={child.link}
                          class="text-foreground hover:bg-muted/50 block rounded-xl px-4 py-2.5 text-sm font-semibold transition-colors duration-200"
                        >
                          <span>{child.label}</span>
                        </a>
                        {child.children.map((sub, si) => (
                          <a
                            href={sub.link}
                            class="text-foreground/60 hover:bg-muted/50 hover:text-foreground block rounded-xl px-4 py-2.5 pl-7 text-[13px] transition-colors duration-200"
                          >
                            <span>{sub.label}</span>
                          </a>
                        ))}
                      </div>
                    ) : (
                      <a
                        href={child.link}
                        class="text-foreground/70 hover:bg-muted/50 hover:text-foreground block rounded-xl px-4 py-2.5 text-sm transition-colors duration-200"
                      >
                        <span>{child.label}</span>
                      </a>
                    ),
                  )}
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <a
      href={navCta.link}
      data-paths={navCta.link}
      class="nav-cta hidden rounded-full px-6 py-2.5 text-[13px] font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.97] lg:inline-flex"
    >
      <span>{navCta.label}</span>
    </a>

    <div class="flex items-center gap-3 lg:hidden">
      <a
        href={navCta.link}
        data-paths={navCta.link}
        class="nav-cta inline-flex rounded-full px-4 py-2 text-xs font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.97]"
      >
        <span>{navCta.label}</span>
      </a>

      <button
        id="nav-toggle"
        class="relative z-50 flex size-10 flex-col items-center justify-center gap-1.5"
        aria-label="Menu"
      >
        <span
          class="bar bar-1 h-[1.5px] w-5 rounded-full transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
        ></span>
        <span
          class="bar bar-2 h-[1.5px] w-5 rounded-full transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
        ></span>
      </button>
    </div>
  </div>
</nav>

<div
  id="mobile-menu"
  transition:persist="mobile-menu"
  class="bg-background fixed inset-0 z-30 transition-all duration-[600ms] ease-[cubic-bezier(0.32,0.72,0,1)] lg:hidden"
>
  <div class="container flex h-full flex-col justify-center">
    {
      navLinks.map((link, i) => (
        <div
          class="m-item border-border/20 border-b transition-all duration-700"
          style={`transition-delay:${80 + i * 40}ms`}
        >
          {link.children?.length ? (
            <>
              <button
                data-paths={link.paths.join(" ")}
                class="m-sub-toggle flex w-full items-center justify-between py-5 text-2xl font-bold"
              >
                <span>{link.label}</span>
                <ChevronDown class="m-chevron size-5 transition-transform duration-300" />
              </button>
              <div class="m-sub overflow-hidden transition-all duration-500">
                {link.children.map((c, ci) =>
                  c.children?.length ? (
                    <div>
                      <a
                        href={c.link}
                        class="block py-2 pl-4 text-lg font-semibold"
                      >
                        <span>{c.label}</span>
                      </a>
                      {c.children.map((sub, si) => (
                        <a
                          href={sub.link}
                          class="text-muted-foreground block py-1.5 pl-8 text-base"
                        >
                          <span>{sub.label}</span>
                        </a>
                      ))}
                    </div>
                  ) : (
                    <a
                      href={c.link}
                      class="text-muted-foreground block py-2 pl-4 text-lg"
                    >
                      <span>{c.label}</span>
                    </a>
                  ),
                )}
              </div>
            </>
          ) : (
            <a
              href={link.link}
              data-paths={link.paths.join(" ")}
              class="m-nav-link block py-5 text-2xl font-bold"
            >
              <span>{link.label}</span>
            </a>
          )}
        </div>
      ))
    }
  </div>
</div>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    transition: all 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .site-nav[data-state="top"] {
    background: transparent;
  }
  .site-nav[data-state="top"].home {
    margin-bottom: -4rem;
  }
  @media (min-width: 1024px) {
    .site-nav[data-state="top"].home {
      margin-bottom: -5rem;
    }
  }
  .site-nav[data-state="scrolled"] {
    background: var(--color-background);
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-border) 30%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
  }

  /* Brand */
  .site-nav[data-state="top"] .nav-brand {
    color: #fff;
  }
  .site-nav[data-state="scrolled"] .nav-brand,
  .site-nav.menu-open .nav-brand {
    color: var(--color-primary);
  }

  /* Nav links / triggers */
  .site-nav[data-state="top"] .nav-link {
    color: color-mix(in oklab, #fff 70%, transparent);
  }
  .site-nav[data-state="top"] .nav-link:hover {
    color: #fff;
  }
  .site-nav[data-state="scrolled"] .nav-link {
    color: color-mix(in oklab, var(--color-foreground) 60%, transparent);
  }
  .site-nav[data-state="scrolled"] .nav-link:hover {
    color: var(--color-foreground);
  }

  /* Active tab — current page. Wins over both data-state rules. */
  .site-nav .nav-link.active,
  .site-nav[data-state="top"] .nav-link.active,
  .site-nav[data-state="scrolled"] .nav-link.active {
    color: var(--color-primary);
  }
  .m-nav-link.active,
  .m-sub-toggle.active {
    color: var(--color-primary);
  }

  /* Dropdown panel */
  .dropdown {
    opacity: 0;
    transform: translate(-50%, 0.25rem);
    pointer-events: none;
  }
  .group:hover .dropdown {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  /* CTA */
  .site-nav[data-state="top"] .nav-cta {
    background: #fff;
    color: #000;
  }
  .site-nav[data-state="top"] .nav-cta:hover {
    background: color-mix(in oklab, #fff 90%, transparent);
  }
  .site-nav[data-state="scrolled"] .nav-cta {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .site-nav[data-state="scrolled"] .nav-cta:hover {
    background: color-mix(in oklab, var(--color-primary) 90%, transparent);
  }
  .site-nav .nav-cta.active {
    box-shadow: 0 0 0 2px
      color-mix(in oklab, var(--color-primary) 45%, transparent);
  }
  /* Mobile menu open: nav sits over the white overlay, so the top-state white
     button would vanish — force the primary fill. */
  .site-nav.menu-open .nav-cta {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }

  /* Hamburger bars */
  .site-nav[data-state="top"] .bar {
    background: #fff;
  }
  .site-nav[data-state="scrolled"] .bar,
  .site-nav.menu-open .bar {
    background: var(--color-foreground);
  }
  .site-nav.menu-open .bar-1 {
    transform: translateY(4px) rotate(45deg);
  }
  .site-nav.menu-open .bar-2 {
    transform: translateY(-2px) rotate(-45deg);
  }

  /* Mobile overlay */
  #mobile-menu {
    opacity: 0;
    pointer-events: none;
  }
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }
  .m-item {
    opacity: 0;
    transform: translateY(1rem);
  }
  #mobile-menu.open .m-item {
    opacity: 1;
    transform: translateY(0);
  }
  .m-sub {
    max-height: 0;
    opacity: 0;
  }
  .m-item.expanded .m-sub {
    max-height: 24rem;
    opacity: 1;
    padding-bottom: 1rem;
  }
  .m-item.expanded .m-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  // The nav + mobile menu are transition:persist elements — a single instance
  // that survives view-transition navigations (like a Next.js layout). So click
  // handling is bound ONCE via delegation on document (never swapped), while
  // per-page state (home transparency, scroll, closing the menu) re-syncs on
  // every astro:page-load.
  const w = window as any;

  if (!w.__navBound) {
    w.__navBound = true;
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;

      if (t.closest("#nav-toggle")) {
        const menu = document.getElementById("mobile-menu");
        const nav = document.getElementById("site-nav");
        const open = menu?.classList.toggle("open");
        nav?.classList.toggle("menu-open", !!open);
        return;
      }

      if (t.closest(".m-sub-toggle")) {
        t.closest(".m-item")?.classList.toggle("expanded");
        return;
      }

      // Link inside the mobile menu → let it close (exit animation plays while
      // the view transition swaps the page underneath the persisted overlay).
      if (t.closest("#mobile-menu a")) {
        document.getElementById("mobile-menu")?.classList.remove("open");
        document.getElementById("site-nav")?.classList.remove("menu-open");
      }
    });
  }

  function syncNav() {
    const nav = document.getElementById("site-nav");
    if (!nav) return;
    const isHome = location.pathname === "/";
    nav.classList.toggle("home", isHome);

    const apply = () => {
      nav.dataset.state = isHome && window.scrollY <= 20 ? "top" : "scrolled";
    };
    // Rebind the scroll listener without stacking duplicates on the persisted node.
    if (w.__navScroll) window.removeEventListener("scroll", w.__navScroll);
    w.__navScroll = apply;
    window.addEventListener("scroll", apply, { passive: true });
    apply();

    // Reset the mobile menu closed after each navigation.
    document.getElementById("mobile-menu")?.classList.remove("open");
    nav.classList.remove("menu-open");
    document
      .querySelectorAll(".m-item.expanded")
      .forEach((el) => el.classList.remove("expanded"));

    syncActive();
  }

  // Highlight the tab that owns the current path. Longest matching owned path
  // wins so /success-stories/spr lights up "Programs" while /success-stories
  // lights up "Success Stories". Runs on the persisted nav + mobile menu.
  function syncActive() {
    const path = location.pathname.replace(/\/+$/, "") || "/";
    const owns = (owned: string) =>
      path === owned || path.startsWith(owned + "/");

    document.querySelectorAll<HTMLElement>("[data-paths]").forEach((el) => {
      el.classList.remove("active");
      el.removeAttribute("aria-current");
    });

    let best: HTMLElement | null = null;
    let bestLen = 0;
    document.querySelectorAll<HTMLElement>("[data-paths]").forEach((el) => {
      for (const owned of (el.dataset.paths || "")
        .split(/\s+/)
        .filter(Boolean)) {
        if (owns(owned) && owned.length > bestLen) {
          best = el;
          bestLen = owned.length;
        }
      }
    });

    // Every element carrying the winning owned path gets marked (desktop + mobile).
    if (best) {
      const winner = (best as HTMLElement).dataset.paths || "";
      document.querySelectorAll<HTMLElement>("[data-paths]").forEach((el) => {
        if ((el.dataset.paths || "") === winner) {
          el.classList.add("active");
          el.setAttribute("aria-current", "page");
        }
      });
    }
  }

  document.addEventListener("astro:page-load", syncNav);
</script>
