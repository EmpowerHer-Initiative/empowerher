---
// Ports components/footer.tsx. Text content is CMS-managed in src/data/site.json
// (global entry → bare data-cms-field paths).
import site from "../data/site.json";
import { Text, Group, Item } from "@alisamadiillc/cms-bridge/components";
import Facebook from "./icons/Facebook.astro";
import Instagram from "./icons/Instagram.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import FileText from "./icons/FileText.astro";

const { name, email, socials, footer } = site;
const year = new Date().getFullYear();

// Icons are picked by the social's label; unknown labels fall back to text.
const socialIcons: Record<string, any> = { Facebook, Instagram, LinkedIn };
---
<footer class="border-border/30 border-t">
  <div class="container py-20 md:py-28">
    <div class="flex flex-col items-start justify-between gap-12 md:flex-row">
      <div class="flex flex-col">
        <a href="/" class="inline-flex">
          <img
            src="https://cdn.empowerher-initiative.org/logo.png"
            alt="EmpowerHer"
            loading="lazy"
            decoding="async"
            class="w-40 -translate-x-6 object-contain md:w-54"
          />
        </a>
        <Text class="text-muted-foreground max-w-sm text-sm leading-[1.8]" field="footer.text" value={footer.text} />
        <a href={`mailto:${email}`} class="text-foreground/70 hover:text-foreground mt-4 text-sm transition-colors" data-cms-field="email">
          Email: {email}
        </a>
        <Text class="text-muted-foreground mt-4 text-sm font-medium" field="footer.est" value={footer.est} />
        <Text class="text-muted-foreground text-sm" field="footer.location" value={footer.location} />
      </div>

      <div class="flex flex-col items-start gap-12 sm:flex-row sm:gap-20">
        <div>
          <Text class="mb-4 text-lg font-bold" field="footer.pagesTitle" value={footer.pagesTitle} />
          <Group as="ul" field="footer.pages" class="space-y-2">
            {footer.pages.map((link, i) => (
              <Item index={i} as="li">
                <a href={link.link} class="text-foreground/60 hover:text-foreground text-sm transition-colors duration-300">
                  <Text as="span" field={`footer.pages.${i}.label`} value={link.label} />
                </a>
              </Item>
            ))}
          </Group>
        </div>

        <div class="flex flex-col items-start">
          <Text class="mb-4 text-lg font-bold" field="footer.followTitle" value={footer.followTitle} />
          <div class="flex gap-4">
            {socials.map((s, i) => {
              const Icon = socialIcons[s.label];
              return (
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="text-foreground/70 hover:text-foreground transition-colors" data-cms-field={`socials.${i}`}>
                  {Icon ? <Icon class="size-6" /> : s.label}
                </a>
              );
            })}
          </div>

          <a href={footer.reportCta.link} class="bg-secondary text-secondary-foreground mt-5 inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium duration-300 will-change-transform hover:scale-105 active:scale-95">
            <FileText class="mr-2 size-4" />
            <Text as="span" field="footer.reportCta.label" value={footer.reportCta.label} />
          </a>
        </div>
      </div>
    </div>

    <div class="border-border/20 mt-20 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row">
      <p class="text-muted-foreground text-xs">&copy; {year} <Text as="span" field="name" value={name} />. <Text as="span" field="footer.rights" value={footer.rights} /></p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-muted-foreground hover:text-foreground text-xs transition-colors"><Text as="span" field="footer.privacyLabel" value={footer.privacyLabel} /></a>
        <a href="/terms" class="text-muted-foreground hover:text-foreground text-xs transition-colors"><Text as="span" field="footer.termsLabel" value={footer.termsLabel} /></a>
      </div>
    </div>
  </div>
</footer>
