---
// Ports components/footer.tsx. Footer text/links are hardcoded here (not
// CMS-managed); brand name, email, and socials are the global identity from
// variables.json.
import variables from "../data/variables.json";
import Facebook from "./icons/Facebook.astro";
import Instagram from "./icons/Instagram.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import FileText from "./icons/FileText.astro";
import { Region } from "@alisamadiillc/cms-bridge/components";

const { name, email, socials } = variables;
const year = new Date().getFullYear();

const footer = {
  text: "We envision Afghan women as guiding lights in their communities, inspiring hope and progress while leading the way to a more equitable, inclusive, and sustainable society.",
  est: "EST. 2024",
  location: "United States of America",
  pagesTitle: "Pages",
  pages: [
    { label: "About", link: "/about-us" },
    { label: "Mentorship", link: "/mentorship" },
    { label: "HerVoice", link: "/hervoice" },
    { label: "Success Stories", link: "/success-stories" },
    { label: "Get Involved", link: "/get-involved" },
    { label: "Resources", link: "/resources" },
    { label: "AGFAF", link: "/agfaf" },
    { label: "Newsletter", link: "/newsletter" },
    { label: "Contact", link: "/contact" },
  ],
  followTitle: "Follow Us",
  reportCta: { label: "Annual Impact Report", link: "/annual-report" },
  rights: "All rights reserved.",
  privacyLabel: "Privacy",
  termsLabel: "Terms",
};

// Icons are picked by the social's label; unknown labels fall back to text.
const socialIcons: Record<string, any> = { Facebook, Instagram, LinkedIn };
---

<footer class="border-border/30 border-t">
  <div class="container py-20 md:py-28">
    <div class="flex flex-col items-start justify-between gap-12 md:flex-row">
      <div class="flex flex-col">
        <a href="/" class="inline-flex">
          <img
            src="https://cdn.empowerher-initiative.org/logo.png"
            alt="EmpowerHer"
            loading="lazy"
            decoding="async"
            class="w-40 -translate-x-6 object-contain md:w-54"
          />
        </a>
        <p class="text-muted-foreground max-w-sm text-sm leading-[1.8]">
          {footer.text}
        </p>
        <Region type="variant" variantName="email">
          <a
            href={`mailto:${email}`}
            class="text-foreground/70 hover:text-foreground mt-4 text-sm transition-colors"
          >
            Email: {email}
          </a>
        </Region>
        <p class="text-muted-foreground mt-4 text-sm font-medium">
          {footer.est}
        </p>
        <p class="text-muted-foreground text-sm">{footer.location}</p>
      </div>

      <div class="flex flex-col items-start gap-12 sm:flex-row sm:gap-20">
        <div>
          <p class="mb-4 text-lg font-bold">{footer.pagesTitle}</p>
          <ul class="space-y-2">
            {
              footer.pages.map((link, i) => (
                <li>
                  <a
                    href={link.link}
                    class="text-foreground/60 hover:text-foreground text-sm transition-colors duration-300"
                  >
                    <span>{link.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col items-start">
          <p class="mb-4 text-lg font-bold">{footer.followTitle}</p>
          <div class="flex gap-4">
            {
              socials.map((s, i) => {
                const Icon = socialIcons[s.label];
                return (
                  <Region type="variant" variantName={`socials.${i}.url`}>
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={s.label}
                      class="text-foreground/70 hover:text-foreground transition-colors"
                    >
                      {Icon ? <Icon class="size-6" /> : s.label}
                    </a>
                  </Region>
                );
              })
            }
          </div>

          <a
            href={footer.reportCta.link}
            class="bg-secondary text-secondary-foreground mt-5 inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-medium duration-300 will-change-transform hover:scale-105 active:scale-95"
          >
            <FileText class="mr-2 size-4" />
            <span>{footer.reportCta.label}</span>
          </a>
        </div>
      </div>
    </div>

    <div
      class="border-border/20 mt-20 flex flex-col items-center justify-between gap-4 border-t pt-8 md:flex-row"
    >
      <p class="text-muted-foreground text-xs">
        &copy; {year}
        <Region type="variant" variantName="name"><span>{name}</span></Region>.
        <span>{footer.rights}</span>
      </p>
      <div class="flex gap-6">
        <a
          href="/privacy"
          class="text-muted-foreground hover:text-foreground text-xs transition-colors"
          ><span>{footer.privacyLabel}</span></a
        >
        <a
          href="/terms"
          class="text-muted-foreground hover:text-foreground text-xs transition-colors"
          ><span>{footer.termsLabel}</span></a
        >
      </div>
    </div>
  </div>
</footer>
