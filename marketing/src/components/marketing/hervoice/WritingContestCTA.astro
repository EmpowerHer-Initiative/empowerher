---
// Ports components/marketing/hervoice/writing-contest-cta.tsx
import ArrowRight from "../../icons/ArrowRight.astro";
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
}
const { eyebrow, heading, description } = Astro.props;
---
<section class="bg-foreground/[0.02] py-28 md:py-40">
  <div class="container">
    <Reveal class="bg-primary text-primary-foreground mx-auto flex max-w-5xl flex-col gap-8 overflow-hidden rounded-[2rem] px-8 py-12 md:flex-row md:items-center md:justify-between md:px-14 md:py-16">
      <div>
        <p class="text-primary-foreground/60 text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
        <h2 class="mt-4 font-serif text-3xl leading-tight md:text-4xl">
          {heading}
        </h2>
        <p class="text-primary-foreground/70 mt-4 max-w-lg text-base leading-relaxed">
          {description}
        </p>
      </div>
      <a
        href="/hervoice/winners"
        class="group bg-background text-foreground inline-flex shrink-0 items-center gap-2.5 rounded-full px-8 py-4 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-xl active:scale-[0.98]"
      >
        Explore Stories
        <ArrowRight class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" />
      </a>
    </Reveal>
  </div>
</section>
