---
// Ports components/marketing/hervoice/how-to-submit.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow: string;
  heading: string;
  headingAccent: string;
  description: string;
  guidelinesTitle: string;
  guidelines: { label: string; text: string }[];
  steps: { num: string; title: string; desc: string }[];
  /** CMS field path prefix for live-preview highlighting (e.g. "howToSubmit"). */
  cmsPath?: string;
}
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  guidelinesTitle,
  guidelines,
  steps,
  cmsPath,
} = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      {/* Left — editorial heading */}
      <Reveal>
        <div>
          <p
            class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
            data-cms-field={cmsField(cmsPath, "eyebrow")}
          >
            {eyebrow}
          </p>
          <h2
            class="mt-4 font-serif text-3xl leading-tight md:text-5xl"
            data-cms-field={cmsField(cmsPath, "heading")}
          >
            {heading}
            <br />
            <span
              class="text-primary italic"
              data-cms-field={cmsField(cmsPath, "headingAccent")}
            >
              {headingAccent}
            </span>
          </h2>
          <p
            class="text-muted-foreground mt-6 max-w-md text-base leading-[1.8]"
            data-cms-field={cmsField(cmsPath, "description")}
          >
            {description}
          </p>

          {/* Guidelines — border-left style like co-founder quotes */}
          <div class="mt-12 space-y-5">
            <p
              class="text-primary text-sm font-semibold tracking-[0.3em] uppercase"
              data-cms-field={cmsField(cmsPath, "guidelinesTitle")}
            >
              {guidelinesTitle}
            </p>
            {guidelines.map(({ label, text }, i) => (
              <div
                class="group border-primary/30 hover:border-primary hover:bg-primary/[0.04] rounded-r-lg border-l-2 py-1.5 pl-5 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:translate-x-1"
              >
                <p
                  class="text-foreground group-hover:text-primary text-lg font-semibold transition-colors duration-500"
                  data-cms-field={cmsField(cmsPath, `guidelines.${i}.label`)}
                >
                  {label}
                </p>
                <p
                  class="text-muted-foreground mt-1 text-base leading-relaxed"
                  data-cms-field={cmsField(cmsPath, `guidelines.${i}.text`)}
                >
                  {text}
                </p>
              </div>
            ))}
          </div>
        </div>
      </Reveal>

      {/* Right — numbered steps in a vertical list */}
      <Reveal class="divide-border space-y-0 divide-y" delay={120}>
        {steps.map((step, i) => (
          <div class="flex gap-6 py-8 first:pt-0 last:pb-0">
            <span
              class="text-primary font-serif text-5xl md:text-6xl"
              data-cms-field={cmsField(cmsPath, `steps.${i}.num`)}
            >
              {step.num}
            </span>
            <div class="pt-1">
              <h3
                class="text-foreground text-lg font-semibold md:text-xl"
                data-cms-field={cmsField(cmsPath, `steps.${i}.title`)}
              >
                {step.title}
              </h3>
              <p
                class="text-muted-foreground mt-2 text-base leading-relaxed"
                data-cms-field={cmsField(cmsPath, `steps.${i}.desc`)}
              >
                {step.desc}
              </p>
            </div>
          </div>
        ))}
      </Reveal>
    </div>
  </div>
</section>
