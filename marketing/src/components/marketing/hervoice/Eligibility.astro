---
// Ports components/marketing/hervoice/eligibility.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  priorityEyebrow: string;
  priorityNote: string;
  requirementsEyebrow: string;
  requirements: { value: string; label: string; note: string }[];
}
const {
  eyebrow,
  heading,
  description,
  priorityEyebrow,
  priorityNote,
  requirementsEyebrow,
  requirements,
} = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="grid gap-16 lg:grid-cols-[1fr_1.2fr] lg:gap-24">
      {/* Left — heading + who can submit */}
      <Reveal>
        <div>
          <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
            {eyebrow}
          </p>
          <h2 class="mt-4 font-serif text-3xl leading-tight md:text-5xl">
            {heading}
          </h2>
          <p class="text-foreground/70 mt-6 text-base leading-[1.8]">
            {description}
          </p>

          {/* Priority callout — editorial blockquote style */}
          <div class="border-primary/30 border-l-primary bg-primary/[0.05] mt-10 rounded-2xl border border-l-4 p-6">
            <p class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase">
              {priorityEyebrow}
            </p>
            <p class="text-foreground mt-2 text-base">
              Students from EmpowerHer's{" "}
              <a
                href="/mentorship"
                class="text-primary hover:text-primary/80 font-medium underline underline-offset-4 transition-colors"
              >
                Creative Writing and Storytelling Workshop
              </a>
            </p>
            <p class="text-muted-foreground mt-3 text-sm">
              {priorityNote}
            </p>
          </div>

          {/* Workshop + Submission — minimal divider list */}
          <div class="divide-border/40 mt-12 space-y-0 divide-y">
            <div class="pb-6">
              <h3 class="text-sm font-semibold">Workshop Enrollment</h3>
              <p class="text-foreground/70 mt-2 text-sm leading-relaxed">
                If you are attending{" "}
                <span class="text-foreground font-medium">any</span>{" "}
                EmpowerHer workshop, you are eligible to submit your writing.
              </p>
            </div>
            <div class="pt-6">
              <h3 class="text-sm font-semibold">Submission Process</h3>
              <p class="text-foreground/70 mt-2 text-sm leading-relaxed">
                Email your submission to{" "}
                <a
                  href="mailto:hervoice@empowerher-initiative.org"
                  class="text-primary hover:text-primary/80 font-medium underline underline-offset-4 transition-colors"
                >
                  hervoice@empowerher-initiative.org
                </a>{" "}
                and include the{" "}
                <span class="text-foreground font-medium">
                  name of the workshop
                </span>{" "}
                you are attending.
              </p>
            </div>
          </div>
        </div>
      </Reveal>

      {/* Right — content requirements as large stat-style cards */}
      <Reveal class="flex flex-col justify-center" delay={120}>
        <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase">
          {requirementsEyebrow}
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {requirements.map((req) => (
            <div class="border-border/60 bg-muted/60 hover:border-primary/30 overflow-hidden rounded-[2rem] border p-8 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-lg">
              <p class="text-primary font-serif text-4xl md:text-5xl">
                {req.value}
              </p>
              <p class="mt-3 text-sm font-semibold">{req.label}</p>
              <p class="text-muted-foreground mt-1 text-xs">
                {req.note}
              </p>
            </div>
          ))}
        </div>

        {/* Warning — red notice */}
        <div class="mt-6 rounded-xl border border-l-4 border-red-200 border-l-red-600 bg-red-50 py-4 pr-5 pl-5">
          <p class="text-foreground/80 text-sm">
            Due to a high volume of submissions, we{" "}
            <span class="font-semibold text-red-700">
              cannot accept pieces that exceed the word limit
            </span>
            .
          </p>
        </div>
      </Reveal>
    </div>
  </div>
</section>
