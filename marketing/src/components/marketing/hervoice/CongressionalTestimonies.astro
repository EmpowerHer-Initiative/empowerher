---
// Ports components/marketing/hervoice/congressional-testimonies.tsx
import Reveal from "../home/Reveal.astro";

const videos = [
  {
    poster:
      "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPT4ggEVZxLP0HVtXjpzDWZR85f7vGSgA1FduQY",
    src: "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPTFAaVBPi81Sgch3ByG9m45xzoRfbnkKwIXpZO",
    label: "Congressional Testimony — Part 1",
  },
  {
    poster:
      "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPTawihdJkAtfy8gUMVlFj5QpoO3BkxsndH9Dm2",
    src: "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPT1BPtxl2QzEuUaBX9YLlpwGm6Z8oisI4dSv7k",
    label: "Congressional Testimony — Part 2",
  },
];
---

<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-4xl">
      <Reveal>
        <p
          class="text-muted-foreground mb-8 text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Amplifying Voices
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h2
          class="text-foreground font-serif text-4xl leading-[1.1] md:text-5xl"
        >
          Congressional Testimonies
        </h2>
      </Reveal>

      <Reveal delay={160}>
        <p
          class="text-muted-foreground mt-8 max-w-2xl text-base leading-relaxed"
        >
          These two congressional testimonies were shared for publication by the
          Afghan Scouts Relief Fund (ASRF) with the EmpowerHer HerVoice
          Initiative.
        </p>
      </Reveal>

      {/* Centered blockquote */}
      <Reveal class="border-border my-16 border-l-2 pl-8">
        <p
          class="text-muted-foreground font-serif text-xl leading-relaxed md:text-2xl"
        >
          &ldquo;These testimonies are representative of the passion of so many
          Afghan women to share their powerful experiences and their drive to
          become their best selves and contribute in their own unique ways to
          society. By sharing the obstacles they have overcome and their amazing
          pursuits, they serve as an inspiration to many of their peers who want
          to navigate their own path to success.&rdquo;
        </p>
        <p
          class="text-muted-foreground mt-6 text-xs font-semibold tracking-[0.3em] uppercase"
        >
          — Afghan Scouts Relief Fund (ASRF)
        </p>
      </Reveal>

      <Reveal delay={80}>
        <p class="text-muted-foreground mb-10 text-sm">
          Coming from a country where their very existence is dehumanized, and
          their human rights are not recognized, their resilience in the face of
          adversity should be a message to the whole world that we must support
          the future of Afghan women in every possible way.
        </p>
      </Reveal>

      {/* Videos */}
      <Reveal delay={160}>
        <div class="grid gap-6 md:grid-cols-2">
          {
            videos.map((video) => (
              <div class="overflow-hidden rounded-2xl">
                <video controls poster={video.poster} class="w-full">
                  <source src={video.src} type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
                <p class="text-muted-foreground mt-3 text-xs font-semibold tracking-[0.2em] uppercase">
                  {video.label}
                </p>
              </div>
            ))
          }
        </div>
      </Reveal>
    </div>
  </div>
</section>
