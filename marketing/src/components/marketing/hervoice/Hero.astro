---
// Ports components/marketing/hervoice/hero.tsx
import ArrowRight from "../../icons/ArrowRight.astro";
import ArrowUpRight from "../../icons/ArrowUpRight.astro";
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  quote: string;
  descriptionAfter: string;
  partnersEyebrow: string;
  partnersText: string;
  closing: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "hero"). */
  cmsPath?: string;
}
const {
  eyebrow,
  heading,
  description,
  quote,
  descriptionAfter,
  partnersEyebrow,
  partnersText,
  closing,
  cmsPath,
} = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-start lg:gap-24">
      {/* Left: large editorial title */}
      <Reveal>
        <div>
          <p
            class="text-primary mb-8 text-xs font-semibold tracking-[0.3em] uppercase"
            data-cms-field={cmsField(cmsPath, "eyebrow")}
          >
            {eyebrow}
          </p>
          <h1
            class="font-serif text-5xl leading-[1.0] md:text-7xl lg:text-8xl"
            data-cms-field={cmsField(cmsPath, "heading")}
          >
            {heading}
          </h1>
        </div>
      </Reveal>

      {/* Right: description + CTA */}
      <Reveal class="lg:pb-4" delay={120}>
        <p
          class="text-muted-foreground text-lg leading-relaxed md:text-xl"
          data-cms-field={cmsField(cmsPath, "description")}
        >
          {description}
        </p>
        <blockquote
          class="border-primary/20 mt-8 border-l-2 pl-6 font-serif text-xl leading-relaxed italic"
          data-cms-field={cmsField(cmsPath, "quote")}
        >
          {quote}
        </blockquote>
        <p
          class="text-muted-foreground mt-8 text-base leading-relaxed"
          data-cms-field={cmsField(cmsPath, "descriptionAfter")}
        >
          {descriptionAfter}
        </p>
        <div class="border-primary/20 bg-primary/[0.04] mt-8 rounded-2xl border p-6">
          <p
            class="text-muted-foreground/50 text-xs font-semibold tracking-[0.2em] uppercase"
            data-cms-field={cmsField(cmsPath, "partnersEyebrow")}
          >
            {partnersEyebrow}
          </p>
          <p
            class="text-muted-foreground mt-3 text-base leading-relaxed"
            data-cms-field={cmsField(cmsPath, "partnersText")}
          >
            {partnersText}
          </p>
        </div>
        <p
          class="mt-8 text-base leading-relaxed font-medium"
          data-cms-field={cmsField(cmsPath, "closing")}
        >
          {closing}
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#writings"
            class="group bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex items-center gap-2.5 rounded-full px-8 py-4 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-xl active:scale-[0.98]"
          >
            Read Stories from HerVoice Here
            <ArrowRight class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" />
          </a>
          <a
            href="/writing-contest"
            class="group border-primary/40 text-foreground hover:border-primary hover:bg-primary/5 hover:shadow-primary/10 inline-flex items-center gap-2 rounded-full border px-6 py-4 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.98]"
          >
            2026 Writing Contest
            <ArrowUpRight class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>
