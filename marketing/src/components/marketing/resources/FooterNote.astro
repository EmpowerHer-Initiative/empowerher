---
// Ports components/marketing/resources/footer-note.tsx
import Reveal from "../home/Reveal.astro";
import ArrowUpRight from "../../icons/ArrowUpRight.astro";

interface Props {
  text: string;
  email?: string;
}

const { text, email } = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase">
          Know a resource?
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="mt-5 font-serif text-4xl leading-tight md:text-5xl">
          Help us grow this list.
        </h2>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-6 max-w-xl text-base leading-relaxed">
          {text}
        </p>
      </Reveal>
      <Reveal delay={240}>
        <a
          href={`mailto:${email}`}
          class="text-foreground mt-8 inline-flex items-center gap-2 text-sm font-medium hover:opacity-70"
        >
          {email}
          <ArrowUpRight class="size-4" />
        </a>
      </Reveal>
    </div>
  </div>
</section>
