---
// Ports components/marketing/resources/footer-note.tsx
import Reveal from "../home/Reveal.astro";
import ArrowUpRight from "../../icons/ArrowUpRight.astro";
import { cmsField } from "../../../lib/cms";
import { Text, Heading2 } from "@alisamadiillc/cms-bridge/components";
import pages from "../../../data/pages.json";
const content = pages.resources;

interface Props {
  text: string;
  email?: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "footerNote"). */
  cmsPath?: string;
}

const { text, email, cmsPath } = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <Text as="p" class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase" field="helpUsGrow.eyebrow" value={content.helpUsGrow.eyebrow} />
      </Reveal>
      <Reveal delay={80}>
        <Heading2 class="mt-5 font-serif text-4xl leading-tight md:text-5xl" field="helpUsGrow.title" value={content.helpUsGrow.title} />
      </Reveal>
      <Reveal delay={160}>
        <Text
          as="p"
          class="text-muted-foreground mt-6 max-w-xl text-base leading-relaxed"
          field={cmsField(cmsPath, "text")}
          value={text}
        />
      </Reveal>
      <Reveal delay={240}>
        <a
          href={`mailto:${email}`}
          data-cms-field={cmsField(cmsPath, "email")}
          class="text-foreground mt-8 inline-flex items-center gap-2 text-sm font-medium hover:opacity-70"
        >
          {email}
          <ArrowUpRight class="size-4" />
        </a>
      </Reveal>
    </div>
  </div>
</section>
