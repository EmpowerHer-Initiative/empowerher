---
// Ports components/marketing/resources/header.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";
import { Heading1, Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow?: string;
  heading: string;
  intro: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "header"). */
  cmsPath?: string;
}

const { eyebrow, heading, intro, cmsPath } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <Text
          as="p"
          class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
          field={cmsField(cmsPath, "eyebrow")}
          value={eyebrow}
        />
      </Reveal>
      <Reveal delay={80}>
        <Heading1
          class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl"
          field={cmsField(cmsPath, "heading")}
          value={heading}
        />
      </Reveal>
      <Reveal delay={160}>
        <Text
          as="p"
          class="text-muted-foreground mt-8 max-w-xl text-base leading-relaxed md:text-lg"
          field={cmsField(cmsPath, "intro")}
          value={intro}
        />
      </Reveal>
    </div>
  </div>
</section>
