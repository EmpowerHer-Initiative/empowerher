---
// Ports components/marketing/resources/header.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  intro: string;
}

const { eyebrow, heading, intro } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl">
          {heading}
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-8 max-w-xl text-base leading-relaxed md:text-lg">
          {intro}
        </p>
      </Reveal>
    </div>
  </div>
</section>
