---
// Ports app/(marketing)/contact/contact-form.tsx
// Form is visual-only — submission backend (tRPC contact.send), validation
// wiring, and the submitted success swap are deferred until the Astro project
// has an API. Inputs/Textarea/Button reproduce the shadcn primitive styles 1:1.
import Mail from "../../icons/Mail.astro";
import MapPin from "../../icons/MapPin.astro";
import Send from "../../icons/Send.astro";
import Facebook from "../../icons/Facebook.astro";
import LinkedIn from "../../icons/LinkedIn.astro";
import Instagram from "../../icons/Instagram.astro";
import Reveal from "../home/Reveal.astro";
import { Heading1, Text, Heading2 } from "@alisamadiillc/cms-bridge/components";
import pages from "../../../data/pages.json";
const content = pages.contact;

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  email: { label: string; value: string };
  location: { label: string; value: string };
  followUsTitle: string;
}

const { eyebrow, heading, intro, email, location, followUsTitle } = Astro.props;

const socialLinks = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/share/157naMfgkw",
    Icon: Facebook,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/empowerher-org/",
    Icon: LinkedIn,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/_empowerher_org",
    Icon: Instagram,
  },
];

const inputClass =
  "border-input file:text-foreground placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 disabled:bg-input/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:bg-input/30 dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 w-full min-w-0 border bg-transparent px-2.5 transition-colors outline-none file:inline-flex file:h-6 file:border-0 file:bg-transparent file:text-sm file:font-medium focus-visible:ring-3 disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-3 md:text-sm h-auto rounded-md py-2 text-base";
---

<section class="py-28 md:py-40">
  <div class="container">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      {/* Left — Contact Info */}
      <Reveal>
        <Text
          as="p"
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          field={"eyebrow"}
          value={eyebrow}
        />
        <Heading1
          class="mt-4 font-serif text-4xl leading-tight md:text-5xl"
          field={"heading"}
          value={heading}
        />
        <Text
          as="p"
          class="text-muted-foreground mt-6 max-w-md text-base leading-[1.8]"
          field={"intro"}
          value={intro}
        />

        <div class="mt-12 space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="bg-primary/10 flex size-10 shrink-0 items-center justify-center rounded-full"
            >
              <Mail class="text-primary size-4" />
            </div>
            <div>
              <Text
                as="p"
                class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase"
                field={"email.label"}
                value={email.label}
              />
              {
                /* Hand-tagged: <a> is not p|span|div (Text scope) and href is a
              hardcoded mailto:, not a {label,link} object (Link scope). */
              }
              <a
                href="mailto:info@empowerher-initiative.org"
                data-cms-field={"email.value"}
                class="text-foreground hover:text-primary mt-1 text-sm transition-colors"
              >
                {email.value}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="bg-primary/10 flex size-10 shrink-0 items-center justify-center rounded-full"
            >
              <MapPin class="text-primary size-4" />
            </div>
            <div>
              <Text
                as="p"
                class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase"
                field={"location.label"}
                value={location.label}
              />
              <Text
                as="p"
                class="text-foreground mt-1 text-sm"
                field={"location.value"}
                value={location.value}
              />
            </div>
          </div>
        </div>

        <div class="border-border/30 mt-12 border-t pt-8">
          <Text
            as="p"
            class="text-muted-foreground text-xs font-semibold tracking-[0.2em] uppercase"
            field={"followUsTitle"}
            value={followUsTitle}
          />
          <div class="mt-4 flex items-center gap-3">
            {
              socialLinks.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="border-border/60 text-foreground/70 hover:border-primary hover:bg-primary hover:text-primary-foreground flex size-11 items-center justify-center rounded-full border transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5"
                >
                  <s.Icon class="size-5" />
                </a>
              ))
            }
          </div>
        </div>
      </Reveal>

      {/* Right — Form */}
      <Reveal delay={120}>
        <div
          id="contact-success"
          class="border-border/40 bg-primary/[0.03] hidden space-y-4 rounded-2xl border p-8"
        >
          <Heading2
            class="font-serif text-2xl"
            field="thankYouYour.title"
            value={content.thankYouYour.title}
          />
          <Text
            as="p"
            class="text-muted-foreground text-base leading-[1.8]"
            field="thankYouYour.text"
            value={content.thankYouYour.text}
          />
          <button
            type="button"
            id="contact-reset"
            class="text-primary text-sm font-medium underline-offset-4 hover:underline"
          >
            Send another message
          </button>
        </div>

        <form id="contact-form" class="space-y-5" novalidate>
          {/* Honeypot — real users never see this; bots fill it and the server drops the send. */}
          <input
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />
          <div role="group" class="group/field flex w-full flex-col gap-2">
            <label
              for="c-name"
              class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none"
            >
              Name
            </label>
            <div class="flex flex-1 flex-col gap-0.5 leading-snug">
              <input
                id="c-name"
                name="name"
                type="text"
                placeholder="Your name"
                class={inputClass}
              />
              <p class="text-destructive text-xs" data-error="name" hidden></p>
            </div>
          </div>

          <div role="group" class="group/field flex w-full flex-col gap-2">
            <label
              for="c-email"
              class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none"
            >
              Email
            </label>
            <div class="flex flex-1 flex-col gap-0.5 leading-snug">
              <input
                id="c-email"
                name="email"
                type="email"
                placeholder="you@example.com"
                class={inputClass}
              />
              <p class="text-destructive text-xs" data-error="email" hidden></p>
            </div>
          </div>

          <div role="group" class="group/field flex w-full flex-col gap-2">
            <label
              for="c-subject"
              class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none"
            >
              Subject
            </label>
            <div class="flex flex-1 flex-col gap-0.5 leading-snug">
              <input
                id="c-subject"
                name="subject"
                type="text"
                placeholder="What is this about?"
                class={inputClass}
              />
            </div>
          </div>

          <div role="group" class="group/field flex w-full flex-col gap-2">
            <label
              for="c-phone"
              class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none"
            >
              Phone <span class="text-muted-foreground font-normal"
                >(optional)</span
              >
            </label>
            <div class="flex flex-1 flex-col gap-0.5 leading-snug">
              <input
                id="c-phone"
                name="phone"
                type="tel"
                placeholder="+1 (555) 123-4567"
                class={inputClass}
              />
            </div>
          </div>

          <div role="group" class="group/field flex w-full flex-col gap-2">
            <label
              for="c-message"
              class="flex w-fit items-center gap-2 text-sm leading-snug font-medium select-none"
            >
              Message
            </label>
            <div class="flex flex-1 flex-col gap-0.5 leading-snug">
              <textarea
                id="c-message"
                name="message"
                placeholder="Tell us what's on your mind..."
                rows="5"
                class="border-input placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 disabled:bg-input/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:bg-input/30 dark:disabled:bg-input/80 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 flex field-sizing-content min-h-16 w-full rounded-lg border bg-transparent px-2.5 py-2 text-base transition-colors outline-none focus-visible:ring-3 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:ring-3 md:text-sm"
              ></textarea>
              <p class="text-destructive text-xs" data-error="message" hidden>
              </p>
            </div>
          </div>

          <button
            type="submit"
            id="contact-submit"
            class="group/button focus-visible:border-ring focus-visible:ring-ring/50 bg-primary text-primary-foreground inline-flex h-10 w-full shrink-0 items-center justify-center gap-1.5 rounded-lg border border-transparent bg-clip-padding px-4 text-base font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:ring-3 active:translate-y-px active:scale-95 disabled:pointer-events-none disabled:opacity-50 md:px-6 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"
          >
            Send Message
            <Send class="ml-2 size-4" />
          </button>
          <p class="text-destructive text-sm" data-error="form" hidden></p>
        </form>
      </Reveal>
    </div>
  </div>
</section>

<script>
  // The site uses <ClientRouter /> view transitions, so page scripts must re-run
  // on astro:page-load. Bind per form instance, guarded so navigation back to
  // this page doesn't stack duplicate listeners on a persisted node.
  function initContactForm() {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;

    const success = document.getElementById("contact-success");
    const submitBtn = document.getElementById(
      "contact-submit",
    ) as HTMLButtonElement | null;

    const setError = (name: string, msg: string | null) => {
      const el = document.querySelector<HTMLElement>(`[data-error="${name}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (!el) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        input?.setAttribute("aria-invalid", "true");
      } else {
        el.hidden = true;
        input?.removeAttribute("aria-invalid");
      }
    };

    const validate = (v: Record<string, string>) => {
      let ok = true;
      const fail = (n: string, m: string) => {
        setError(n, m);
        ok = false;
      };
      setError("name", null);
      setError("email", null);
      setError("message", null);
      setError("form", null);

      if (!v.name) fail("name", "Name is required");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email))
        fail("email", "Please enter a valid email");
      if (v.message.length < 10)
        fail("message", "Message must be at least 10 characters");
      return ok;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const v = {
        name: String(data.get("name") || "").trim(),
        email: String(data.get("email") || "").trim(),
        subject: String(data.get("subject") || "").trim(),
        phone: String(data.get("phone") || "").trim(),
        message: String(data.get("message") || "").trim(),
      };
      if (!validate(v)) return;

      const originalBtn = submitBtn?.innerHTML;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      let failed: string | null = null;
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: v.name,
            email: v.email,
            subject: v.subject,
            phone: v.phone,
            message: v.message,
            company: String(data.get("company") || ""),
          }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => null);
          failed = err?.error || "Something went wrong — please try again.";
        }
      } catch {
        failed = "Network error — please try again.";
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        if (originalBtn !== undefined) submitBtn.innerHTML = originalBtn;
      }

      if (failed) {
        setError("form", failed);
        return;
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    });

    document.getElementById("contact-reset")?.addEventListener("click", () => {
      form.reset();
      success?.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
