---
// Ports app/(marketing)/afgaf/page.tsx (identical to agfaf/page.tsx).
import Reveal from "../home/Reveal.astro";
import ExternalLink from "../../icons/ExternalLink.astro";

const description = [
  "The Afghan Girls Financial Assistance Fund (AGFAF) is a U.S.-based nonprofit organization dedicated to empowering young Afghan women through education. Founded in response to the systemic barriers Afghan girls face in accessing quality education, AGFAF works to identify, support, and sponsor talented students who demonstrate academic promise and leadership potential.",
  "AGFAF partners with high schools, colleges, and universities across the United States to provide full financial aid, housing, and mentorship for Afghan girls who have limited or no access to education in their home country. In addition to academic support, AGFAF also offers guidance in college and career planning, cultural adjustment, and leadership development, helping these students become confident, educated changemakers within their communities and beyond.",
  "The organization's mission is rooted in the belief that educating girls is one of the most powerful tools for creating lasting peace, gender equality, and economic growth in Afghanistan and the world.",
  "AGFAF is a network of scholars, educators, host families, and advocates empowering Afghan girls to learn, lead, and thrive.",
];
---

<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      {/* Logo */}
      <Reveal class="flex justify-center">
        <img
          src="https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPTpavV7aqrM0zsm5gThJ2eDxZtjCFUdBGElvb1"
          alt="AGFAF — Afghan Girls Financial Assistance Fund"
          class="w-72 object-contain"
          fetchpriority="high"
          decoding="async"
        />
      </Reveal>

      {/* Title */}
      <Reveal>
        <h1 class="mt-16 font-serif text-3xl leading-tight md:text-4xl">
          Afghan Girls Financial Assistance Fund (AGFAF)
        </h1>
      </Reveal>

      {/* Description */}
      <Reveal>
        <div
          class="text-muted-foreground mt-8 space-y-6 text-base leading-relaxed"
        >
          {
            description.map((paragraph) => (
              <p>
                <span>{paragraph}</span>
              </p>
            ))
          }
        </div>
      </Reveal>

      {/* Gratitude */}
      <Reveal
        class="border-l-primary bg-primary/[0.05] mt-12 rounded-r-2xl border-l-4 p-8"
      >
        <p class="text-foreground font-semibold italic">
          Our Deepest Gratitude
        </p>
        <blockquote class="text-muted-foreground mt-4 leading-relaxed italic">
          EmpowerHer deeply values the unwavering support of the Afghan Girls
          Financial Assistance Fund (AGFAF). As our primary sponsor and partner,
          AGFAF has played a pivotal role in making many of our initiatives and
          programs possible. For nearly two decades, AGFAF has illuminated the
          path toward a brighter future for countless Afghan girls. As fellow
          Afghans and an organization aligned with their mission and vision, we
          extend our heartfelt gratitude for their continued support and belief
          in our work.
        </blockquote>
      </Reveal>

      {/* CTA */}
      <Reveal class="mt-12 flex justify-center">
        <a
          href="https://agfaf.org"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg active:scale-[0.98]"
        >
          Visit AGFAF's Website
          <ExternalLink
            class="size-4 transition-transform duration-300 group-hover:translate-x-px group-hover:-translate-y-px"
          />
        </a>
      </Reveal>
    </div>
  </div>
</section>
