---
// Ports components/marketing/success-stories/closing-cta.tsx
import Heart from "../../icons/Heart.astro";
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow: string;
  heading: string;
  /** CMS field path prefix for live-preview highlighting. */
  cmsPath?: string;
}
const { eyebrow, heading, cmsPath } = Astro.props;
---
<section class="pb-28 md:pb-40">
  <div class="container">
    <div class="mx-auto max-w-2xl text-center">
      <Reveal>
        <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase" data-cms-field={cmsField(cmsPath, "eyebrow")}>
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="mt-5 font-serif text-3xl md:text-5xl" data-cms-field={cmsField(cmsPath, "heading")}>
          {heading}
        </h2>
      </Reveal>
      <Reveal class="mt-10" delay={160}>
        <a
          href="/get-involved"
          class="group bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg active:scale-[0.98]"
        >
          <Heart class="size-4" />
          Get Involved
        </a>
      </Reveal>
    </div>
  </div>
</section>
