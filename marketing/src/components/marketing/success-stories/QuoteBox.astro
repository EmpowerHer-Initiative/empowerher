---
// Ports the QuoteBox from components/marketing/success-stories/_shared.tsx
import { cmsField } from "../../../lib/cms";

const { author, cmsPath } = Astro.props;
---
<div class="bg-muted/50 border-l-primary rounded-2xl border-l-4 p-6 md:p-8">
  <p class="text-foreground/80 text-base leading-relaxed" data-cms-field={cmsField(cmsPath, "body")}><slot /></p>
  {author && (
    <p class="text-foreground mt-4 text-sm font-semibold" data-cms-field={cmsField(cmsPath, "author")}>— {author}</p>
  )}
</div>
