---
// Ports the QuoteBox from components/marketing/success-stories/_shared.tsx
import type { CmsField } from "@alisamadiillc/cms-bridge/fields";

const { author, cmsPath } = Astro.props;
const f = (s: string): CmsField | undefined =>
  cmsPath ? (`${cmsPath}.${s}` as CmsField) : undefined;
---

<div class="bg-muted/50 border-l-primary rounded-2xl border-l-4 p-6 md:p-8">
  <p
    class="text-foreground/80 text-base leading-relaxed"
    data-cms-field={f("body")}
  >
    <slot />
  </p>
  {
    author && (
      <p
        class="text-foreground mt-4 text-sm font-semibold"
        data-cms-field={f("author")}
      >
        — {author}
      </p>
    )
  }
</div>
