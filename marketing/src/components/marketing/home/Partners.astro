---
// Ports components/partners-section.tsx (rendered by home/partners.tsx).
// Partner list is synced from the admin DB by scripts/sync-from-db.ts.
import Reveal from "./Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow: string;
  partners: { name: string; image: string; link: string }[];
  cmsPath?: string;
}
const { eyebrow, partners, cmsPath } = Astro.props;
---
{partners.length > 0 && (
  <section class="py-28 md:py-32">
    <div class="container">
      <Reveal>
        <p class="text-muted-foreground text-center text-xs font-semibold tracking-[0.3em] uppercase" data-cms-field={cmsField(cmsPath, "eyebrow")}>
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <div class="mt-12 flex flex-wrap items-center justify-center gap-10 md:gap-16">
          {partners.map((p, i) => (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              title={p.name}
              class="group block transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1.5 hover:scale-105"
            >
              <img src={p.image} alt={p.name} loading="lazy" decoding="async" class="h-16 w-auto object-contain md:h-24" />
            </a>
          ))}
        </div>
      </Reveal>
    </div>
  </section>
)}
