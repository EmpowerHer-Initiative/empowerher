---
// Ports components/marketing/home/at-a-glance.tsx
import Reveal from "./Reveal.astro";
import CountUp from "./CountUp.astro";

function parseNumber(number: string) {
  const m = number.match(/^([\d.]+)(.*)$/);
  const numeric = m ? m[1] : number;
  const suffix = m ? m[2] : "";
  const dot = numeric.indexOf(".");
  const decimals = dot === -1 ? 0 : numeric.length - dot - 1;
  return { to: parseFloat(numeric), decimals, suffix };
}

const stats = [
  {
    number: "500+",
    label: "Students Mentored",
  },
  {
    number: "9+",
    label: "Countries Reached",
    detail:
      "Afghanistan, Tajikistan, Kazakhstan, Pakistan, Iran, Turkey, India, Bangladesh, Malaysia",
  },
  {
    number: "8+",
    label: "Countries in Our Global Team",
    detail:
      "Afghanistan, Poland, Peru, United States, China, Pakistan, Iran, Bangladesh",
  },
  {
    number: "25+",
    label: "Provinces of Afghanistan Reached",
  },
  {
    number: "50+",
    label: "Student Publications",
    detail: "Published through HerVoice",
  },
].map((s: { number: string; label: string; detail?: string }) => ({
  ...parseNumber(s.number),
  label: s.label,
  detail: s.detail,
}));
---

<section class="border-border/40 bg-primary/[0.03] border-y py-20 md:py-28">
  <div class="container">
    <Reveal class="max-w-2xl">
      <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
        By the Numbers
      </p>
      <h2 class="mt-4 font-serif text-3xl leading-tight md:text-5xl">
        EmpowerHer at a Glance
      </h2>
    </Reveal>

    <div
      class="divide-border/40 mt-14 grid grid-cols-1 divide-y sm:grid-cols-2 sm:divide-x lg:grid-cols-5 lg:divide-y-0"
    >
      {
        stats.map((s) => (
          <div class="flex flex-col gap-2 px-2 py-8 sm:px-8 sm:py-2">
            <span class="text-primary font-serif text-4xl md:text-5xl">
              <CountUp to={s.to} decimals={s.decimals} suffix={s.suffix} />
            </span>
            <span class="text-foreground text-sm font-medium">{s.label}</span>
            {s.detail && (
              <span class="text-muted-foreground text-xs leading-relaxed">
                {s.detail}
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
