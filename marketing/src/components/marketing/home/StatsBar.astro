---
// Ports components/marketing/home/stats-bar.tsx
import ArrowRight from "../../icons/ArrowRight.astro";
import Reveal from "./Reveal.astro";
import CountUp from "./CountUp.astro";

function parseNumber(number: string) {
  const m = number.match(/^([\d.]+)(.*)$/);
  const numeric = m ? m[1] : number;
  const suffix = m ? m[2] : "";
  const dot = numeric.indexOf(".");
  const decimals = dot === -1 ? 0 : numeric.length - dot - 1;
  return { to: parseFloat(numeric), decimals, suffix };
}

const stats = [
  {
    number: "1.4 million",
    label:
      "Girls have been deliberately denied access to secondary education since 2021.",
  },
  {
    number: "2.5 million",
    label:
      "Afghan girls (80% of school-age girls) are currently deprived of their right to education.",
  },
  {
    number: "80%",
    label: "Of school-age Afghan girls are currently out of school.",
  },
].map((s) => ({
  ...parseNumber(s.number),
  label: s.label,
}));
---

<section class="border-border/40 bg-black border-y py-20 md:py-28">
  <div class="container">
    <Reveal class="max-w-2xl">
      <h2 class="font-serif text-3xl leading-tight md:text-5xl text-white">
        Abandoned Futures: Let Afghan Girls Learn
      </h2>
      <p
        class="text-white mt-6 max-w-md text-base leading-relaxed md:text-lg"
      >
        Since September 2021, all Afghan girls over the age of 12 have been
        banned from attending school.
      </p>
      <a
        href="https://www.unesco.org/en/articles/afghanistan-14-million-girls-still-banned-school-de-facto-authorities"
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-primary text-primary-foreground hover:shadow-primary/25 mt-8 inline-flex items-center gap-2.5 rounded-full px-8 py-4 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-xl active:scale-[0.98]"
      >
        More Details
        <ArrowRight
          class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5"
        />
      </a>
    </Reveal>

    <div
      class="divide-border/40 mt-14 grid grid-cols-1 divide-y md:grid-cols-3 md:divide-x md:divide-y-0"
    >
      {
        stats.map((s) => (
          <div class="flex flex-col gap-2 px-2 py-8 md:px-8 md:py-2">
            <span class="text-white font-serif text-4xl md:text-5xl">
              <CountUp to={s.to} decimals={s.decimals} suffix={s.suffix} />
            </span>
            <span class="text-white max-w-xs text-sm leading-snug">
              {s.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
