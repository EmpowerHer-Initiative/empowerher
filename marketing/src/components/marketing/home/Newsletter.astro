---
// Ports components/marketing/home/newsletter.tsx
// Submits to the admin app's public POST /api/newsletter route via
// src/lib/newsletter.ts, swapping to a success message on subscribe.
import Heart from "../../icons/Heart.astro";
import Reveal from "./Reveal.astro";
import Highlight from "../../Highlight.astro";
import { cmsField } from "../../../lib/cms";
import { Heading3, Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  badge: string;
  heading: string;
  heading2: string;
  bodyText: string;
  cardTitle: string;
  cardBody: string;
  footnote: string;
  cmsPath?: string;
}
const { badge, heading, heading2, bodyText, cardTitle, cardBody, footnote, cmsPath } = Astro.props;
---
<section class="bg-muted text-foreground relative overflow-hidden py-28 md:py-40">
  <div class="bg-primary/[0.08] pointer-events-none absolute -top-32 -left-32 size-96 rounded-full blur-3xl"></div>
  <div class="bg-secondary/[0.08] pointer-events-none absolute -right-24 -bottom-24 size-80 rounded-full blur-3xl"></div>
  <div class="border-foreground/[0.04] pointer-events-none absolute top-1/2 left-1/2 size-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full border"></div>
  <div class="border-foreground/[0.04] pointer-events-none absolute top-1/2 left-1/2 size-[400px] -translate-x-1/2 -translate-y-1/2 rounded-full border"></div>

  <div class="relative container">
    <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-24">
      <Reveal>
        <div>
          <div class="border-border bg-card inline-flex items-center gap-2 rounded-full border px-4 py-1.5">
            <Heart class="text-primary size-3.5" />
            <Text as="span" class="text-muted-foreground text-[10px] font-semibold tracking-[0.2em] uppercase" field={cmsField(cmsPath, "badge")} value={badge} />
          </div>
          <h2 class="mt-6 font-serif text-4xl leading-tight md:text-5xl">
            <Text as="span" field={cmsField(cmsPath, "heading")} value={heading} />
            <br />
            <!-- heading2 uses Highlight hlClass="italic" — bridge can't reproduce that highlight class, so KEPT hand-tagged. -->
            <span data-cms-field={cmsField(cmsPath, "heading2")}><Highlight text={heading2} hlClass="italic" /></span>
          </h2>
          <Text as="p" class="text-muted-foreground mt-6 max-w-md text-base leading-[1.8]" field={cmsField(cmsPath, "bodyText")} value={bodyText} />
        </div>
      </Reveal>

      <Reveal delay={120}>
        <div class="border-border bg-card rounded-3xl border p-8 shadow-sm md:p-10">
          <Heading3 class="font-serif text-2xl" field={cmsField(cmsPath, "cardTitle")} value={cardTitle} />
          <Text as="p" class="text-muted-foreground mt-3 text-sm leading-relaxed" field={cmsField(cmsPath, "cardBody")} value={cardBody} />
          <form id="home-newsletter-form" class="mt-8 space-y-4" novalidate>
            <div>
              <input
                name="email"
                type="email"
                placeholder="Your email address"
                class="border-border bg-background text-foreground placeholder:text-muted-foreground focus:border-primary/40 w-full rounded-xl border px-5 py-3.5 text-sm transition-all duration-300 outline-none disabled:opacity-60"
              />
              <p class="text-destructive mt-2 text-xs" data-error="email" hidden></p>
            </div>
            <p class="text-destructive text-xs" data-error="form" hidden></p>
            <button
              type="submit"
              id="home-newsletter-submit"
              class="bg-primary text-primary-foreground hover:bg-primary/90 w-full rounded-xl py-3.5 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] disabled:opacity-60"
            >
              Subscribe
            </button>
          </form>
          <p
            id="home-newsletter-success"
            class="text-foreground mt-8 hidden text-center text-sm font-medium"
            data-success-text
          ></p>
        </div>
      </Reveal>
    </div>
  </div>
</section>

<script>
  import { subscribeNewsletter } from "../../../lib/newsletter";

  // Re-run on astro:page-load (view transitions); bind once per form instance.
  function initHomeNewsletterForm() {
    const form = document.getElementById("home-newsletter-form") as HTMLFormElement | null;
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;

    const success = document.getElementById("home-newsletter-success");
    const submitBtn = document.getElementById("home-newsletter-submit") as HTMLButtonElement | null;

    const setError = (name: string, msg: string | null) => {
      const el = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (!el) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        input?.setAttribute("aria-invalid", "true");
      } else {
        el.hidden = true;
        input?.removeAttribute("aria-invalid");
      }
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setError("email", null);
      setError("form", null);

      const email = String(new FormData(form).get("email") || "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError("email", "Please enter a valid email");
        return;
      }

      const original = submitBtn?.innerHTML;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Subscribing…";
      }
      const result = await subscribeNewsletter(email);
      if (submitBtn) {
        submitBtn.disabled = false;
        if (original !== undefined) submitBtn.innerHTML = original;
      }

      if (!result.ok) {
        setError(
          "form",
          result.error === "rate_limited"
            ? "Too many requests — please try again in a few minutes."
            : "Something went wrong. Please try again.",
        );
        return;
      }

      if (success) {
        success.textContent = result.alreadySubscribed
          ? "You're already on the list — thanks for your support!"
          : "Thanks for subscribing — watch your inbox for our next update.";
        success.classList.remove("hidden");
      }
      form.classList.add("hidden");
    });
  }

  document.addEventListener("astro:page-load", initHomeNewsletterForm);
</script>
