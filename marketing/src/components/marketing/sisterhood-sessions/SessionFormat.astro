---
// Ports components/marketing/sisterhood-sessions/session-format.tsx
import Reveal from "../home/Reveal.astro";
import {
  Heading2,
  Heading3,
  Text,
  Group,
  Item,
  Link,
} from "@alisamadiillc/cms-bridge/components";
import pages from "../../../data/pages.json";
const content = pages["sisterhood-sessions"];

interface Card {
  title: string;
  highlight?: string;
  body: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  cards: Card[];
  closing: string;
}
const { eyebrow, heading, cards, closing } = Astro.props;
---

<section class="bg-foreground/[0.02] py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-4xl">
      <Reveal delay={0}>
        <Text
          as="p"
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          field={"sessionFormat.eyebrow"}
          value={eyebrow}
        />
      </Reveal>
      <Reveal delay={80}>
        <Heading2
          class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl"
          field={"sessionFormat.heading"}
          value={heading}
        />
      </Reveal>

      <Reveal delay={160}>
        <Group
          as="div"
          field={"sessionFormat.cards"}
          class="mt-14 grid gap-6 md:grid-cols-2"
        >
          {
            cards.map((card, i) => (
              <Item
                index={i}
                class="border-border/40 bg-background rounded-3xl border p-10"
              >
                <Heading3
                  class="text-xl font-semibold"
                  field={`sessionFormat.cards.${i}.title`}
                  value={card.title}
                />
                {card.highlight && (
                  <Text
                    as="p"
                    class="text-primary mt-4 font-serif text-5xl"
                    field={`sessionFormat.cards.${i}.highlight`}
                    value={card.highlight}
                  />
                )}
                <Text
                  as="p"
                  class="text-muted-foreground mt-4 text-base leading-relaxed"
                  field={`sessionFormat.cards.${i}.body`}
                  value={card.body}
                />
              </Item>
            ))
          }
        </Group>
      </Reveal>

      <Reveal delay={0}>
        <Text
          as="p"
          class="text-muted-foreground mt-14 text-base leading-relaxed md:text-lg"
          field={"sessionFormat.closing"}
          value={closing}
        />
      </Reveal>

      <Reveal delay={80}>
        <div class="mt-12">
          <Link
            class="border-border/60 text-foreground/70 hover:border-foreground/30 hover:text-foreground inline-flex items-center gap-2 rounded-full border px-7 py-3.5 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
            field="section.cta"
            value={content.section.cta}>{content.section.cta.label}</Link
          >
        </div>
      </Reveal>
    </div>
  </div>
</section>
