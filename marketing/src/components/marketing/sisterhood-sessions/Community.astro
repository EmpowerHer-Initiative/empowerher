---
// Ports components/marketing/sisterhood-sessions/community.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  listIntro: string;
  benefits: string[];
  closing: string;
}
const { eyebrow, heading, body, listIntro, benefits, closing } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal delay={0}>
        <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
          {heading}
        </h2>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-8 text-lg leading-relaxed">
          {body}
        </p>
      </Reveal>
      <Reveal delay={240}>
        <p class="mt-10 text-base font-semibold">
          {listIntro}
        </p>
      </Reveal>

      {/* Numbered list — large serif numbers */}
      <Reveal delay={320}>
        <div class="divide-border/40 mt-6 divide-y">
          {benefits.map((benefit, i) => (
            <div
              class="group hover:bg-muted/20 flex items-start gap-8 py-7 transition-colors duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] md:gap-12"
            >
              <span class="text-muted-foreground/25 group-hover:text-primary/25 font-serif text-4xl leading-none transition-colors duration-500 md:text-5xl">
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="text-muted-foreground pt-2 text-base leading-relaxed md:text-lg">
                {benefit}
              </p>
            </div>
          ))}
        </div>
      </Reveal>

      <Reveal delay={0}>
        <p class="text-muted-foreground mt-10 text-lg leading-relaxed">
          {closing}
        </p>
      </Reveal>
    </div>
  </div>
</section>
