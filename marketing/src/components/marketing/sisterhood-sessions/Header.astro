---
// Ports components/marketing/sisterhood-sessions/header.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
}
const { eyebrow, heading, body } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal delay={0}>
        <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="mt-5 font-serif text-4xl leading-[1.1] md:text-6xl">
          {heading}
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-8 text-lg leading-relaxed">
          {body}
        </p>
      </Reveal>
    </div>
  </div>
</section>
