---
// Ports components/marketing/sisterhood-sessions/why-they-matter.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote: string;
}
const { eyebrow, heading, body, quote } = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal delay={0}>
        <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
          {heading}
        </h2>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-8 text-lg leading-relaxed">
          {body}
        </p>
      </Reveal>
      <Reveal delay={240}>
        <blockquote class="border-border text-muted-foreground mt-14 border-l-2 pl-8 font-serif text-2xl leading-[1.4] md:text-3xl">
          {quote}
        </blockquote>
      </Reveal>
    </div>
  </div>
</section>
