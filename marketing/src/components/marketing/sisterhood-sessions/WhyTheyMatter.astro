---
// Ports components/marketing/sisterhood-sessions/why-they-matter.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";
import { Heading2, Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  quote: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "whyTheyMatter"). */
  cmsPath?: string;
}
const { eyebrow, heading, body, quote, cmsPath } = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal delay={0}>
        <Text
          as="p"
          class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
          field={cmsField(cmsPath, "eyebrow")}
          value={eyebrow}
        />
      </Reveal>
      <Reveal delay={80}>
        <Heading2
          class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl"
          field={cmsField(cmsPath, "heading")}
          value={heading}
        />
      </Reveal>
      <Reveal delay={160}>
        <Text
          as="p"
          class="text-muted-foreground mt-8 text-lg leading-relaxed"
          field={cmsField(cmsPath, "body")}
          value={body}
        />
      </Reveal>
      <Reveal delay={240}>
        <Text
          as="blockquote"
          class="border-border text-muted-foreground mt-14 border-l-2 pl-8 font-serif text-2xl leading-[1.4] md:text-3xl"
          field={cmsField(cmsPath, "quote")}
          value={quote}
        />
      </Reveal>
    </div>
  </div>
</section>
