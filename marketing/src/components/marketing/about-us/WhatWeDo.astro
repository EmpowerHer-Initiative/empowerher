---
// Ports components/marketing/about-us/what-we-do.tsx
import Reveal from "../home/Reveal.astro";
import {
  Group,
  Heading2,
  Heading3,
  Item,
  Text,
} from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  pillars: { index: string; title: string; description: string }[];
}
const { eyebrow, heading, intro, pillars } = Astro.props;
---

<section class="py-28 md:py-40">
  <div class="container">
    <div
      class="mb-20 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <Reveal>
        <div>
          <Text
            as="p"
            class="text-primary mb-4 text-xs font-semibold tracking-[0.3em] uppercase"
            field={"whatWeDo.eyebrow"}
            value={eyebrow}
          />
          <Heading2
            class="font-serif text-4xl leading-[1.1] md:text-5xl"
            field={"whatWeDo.heading"}
            value={heading}
          />
        </div>
      </Reveal>
      <Reveal delay={80}>
        <Text
          as="p"
          class="text-muted-foreground max-w-sm text-sm leading-relaxed md:text-right"
          field={"whatWeDo.intro"}
          value={intro}
        />
      </Reveal>
    </div>

    {/* Alternating full-width blocks */}
    <Group field={"whatWeDo.pillars"} class="divide-border/40 divide-y">
      {
        pillars.map((item, i) => (
          <Reveal delay={i * 80}>
            <Item
              index={i}
              class={`group hover:bg-muted/30 flex flex-col gap-8 py-10 transition-colors duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] md:flex-row md:items-center md:gap-0 ${
                i % 2 !== 0 ? "md:flex-row-reverse" : ""
              }`}
            >
              <div class="md:w-1/4">
                <Text
                  as="span"
                  class="text-primary/30 group-hover:text-primary/60 font-serif text-6xl transition-colors duration-500 md:text-8xl"
                  field={`whatWeDo.pillars.${i}.index`}
                  value={item.index}
                />
              </div>
              <div class={`md:w-3/4 ${i % 2 !== 0 ? "md:pr-16" : "md:pl-16"}`}>
                <Heading3
                  class="text-2xl font-semibold md:text-3xl"
                  field={`whatWeDo.pillars.${i}.title`}
                  value={item.title}
                />
                <Text
                  as="p"
                  class="text-muted-foreground mt-4 max-w-2xl text-base leading-relaxed"
                  field={`whatWeDo.pillars.${i}.description`}
                  value={item.description}
                />
              </div>
            </Item>
          </Reveal>
        ))
      }
    </Group>
  </div>
</section>
