---
// Ports components/marketing/about-us/mission-vision.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";
import { Heading2, Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  cards: { eyebrow: string; heading: string; body: string }[];
  /** CMS field path prefix for live-preview highlighting (e.g. "missionVision"). */
  cmsPath?: string;
}
const { cards, cmsPath } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="grid gap-6 md:gap-8 lg:grid-cols-2">
      <Reveal>
        <div class="group border-border/60 bg-muted/30 hover:border-primary/30 h-full rounded-[2rem] border p-10 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-xl md:p-14">
          <Text
            as="p"
            class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
            field={cmsField(cmsPath, "cards.0.eyebrow")}
            value={cards[0].eyebrow}
          />
          <Heading2
            class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl lg:text-6xl"
            field={cmsField(cmsPath, "cards.0.heading")}
            value={cards[0].heading}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-8 text-base leading-relaxed md:text-lg"
            field={cmsField(cmsPath, "cards.0.body")}
            value={cards[0].body}
          />
        </div>
      </Reveal>

      <Reveal delay={120}>
        <div class="group border-border/60 bg-muted text-foreground hover:border-primary/40 h-full rounded-[2rem] border p-10 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-xl md:p-14">
          <Text
            as="p"
            class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
            field={cmsField(cmsPath, "cards.1.eyebrow")}
            value={cards[1].eyebrow}
          />
          <Heading2
            class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl lg:text-6xl"
            field={cmsField(cmsPath, "cards.1.heading")}
            value={cards[1].heading}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-8 text-base leading-relaxed md:text-lg"
            field={cmsField(cmsPath, "cards.1.body")}
            value={cards[1].body}
          />
        </div>
      </Reveal>
    </div>
  </div>
</section>
