---
// Ports components/marketing/about-us/our-story.tsx
import Reveal from "../home/Reveal.astro";
import { Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  bodyBefore: string[];
  pullQuote: string;
  bodyAfter: string[];
}
const { eyebrow, bodyBefore, pullQuote, bodyAfter } = Astro.props;
---

<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal>
        <Text
          as="p"
          class="text-muted-foreground mb-8 text-xs font-semibold tracking-[0.3em] uppercase"
          field={"ourStory.eyebrow"}
          value={eyebrow}
        />
      </Reveal>

      <Reveal delay={80}>
        <div class="text-muted-foreground space-y-7 text-lg leading-relaxed">
          {
            bodyBefore.map((paragraph, i) => (
              <p
                data-cms-field={`ourStory.bodyBefore.${i}`}
                set:html={paragraph}
              />
            ))
          }
        </div>
      </Reveal>

      {/* Pull Quote */}
      <Reveal delay={160}>
        <blockquote class="border-border my-14 border-l-2 pl-8">
          <Text
            as="p"
            class="text-foreground font-serif text-2xl leading-snug md:text-3xl"
            field={"ourStory.pullQuote"}
            value={pullQuote}
          />
        </blockquote>
      </Reveal>

      <Reveal delay={80}>
        <div class="text-muted-foreground space-y-7 text-lg leading-relaxed">
          {
            bodyAfter.map((paragraph, i) => (
              <p
                data-cms-field={`ourStory.bodyAfter.${i}`}
                set:html={paragraph}
              />
            ))
          }
        </div>
      </Reveal>
    </div>
  </div>
</section>
