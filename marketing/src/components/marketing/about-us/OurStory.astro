---
// Ports components/marketing/about-us/our-story.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  bodyBefore: string[];
  pullQuote: string;
  bodyAfter: string[];
}
const { eyebrow, bodyBefore, pullQuote, bodyAfter } = Astro.props;
---
<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <Reveal>
        <p class="text-muted-foreground mb-8 text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
      </Reveal>

      <Reveal delay={80}>
        <div class="text-muted-foreground space-y-7 text-lg leading-relaxed">
          {bodyBefore.map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </Reveal>

      <!-- Pull Quote -->
      <Reveal delay={160}>
        <blockquote class="border-border my-14 border-l-2 pl-8">
          <p class="text-foreground font-serif text-2xl leading-snug md:text-3xl">
            {pullQuote}
          </p>
        </blockquote>
      </Reveal>

      <Reveal delay={80}>
        <div class="text-muted-foreground space-y-7 text-lg leading-relaxed">
          {bodyAfter.map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </Reveal>
    </div>
  </div>
</section>
