---
// Ports components/marketing/newsletter/newsletter-form.tsx
// Submits to the admin app's public POST /api/newsletter route via
// src/lib/newsletter.ts, swapping to a success message on subscribe.
import Send from "../../icons/Send.astro";
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";
import { Heading1, Heading3, Text, Image } from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  image: { url: string; alt: string };
  overlay: { heading: string; text: string };
  /** CMS field path prefix for live-preview highlighting (root-level pass ""). */
  cmsPath?: string;
}

const { eyebrow, heading, subheading, image, overlay, cmsPath } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="border-border/50 mx-auto grid max-w-5xl overflow-hidden rounded-3xl border md:grid-cols-2">
      <Reveal class="flex flex-col justify-center p-8 md:p-12">
        <Text
          as="p"
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          field={cmsField(cmsPath, "eyebrow")}
          value={eyebrow}
        />
        <Heading1
          class="mt-4 font-serif text-3xl leading-tight md:text-4xl"
          field={cmsField(cmsPath, "heading")}
          value={heading}
        />
        <Text
          as="p"
          class="text-muted-foreground mt-4 text-base leading-relaxed"
          field={cmsField(cmsPath, "subheading")}
          value={subheading}
        />

        <div class="mt-8">
          <div
            id="newsletter-page-success"
            class="border-border/40 bg-primary/[0.03] hidden rounded-2xl border p-6 text-sm"
          >
            <p class="text-foreground font-medium">You're subscribed 🎉</p>
            <p class="text-muted-foreground mt-1" data-success-text>
              Thanks for joining — watch your inbox for our next update.
            </p>
          </div>

          <form id="newsletter-page-form" class="space-y-4" novalidate>
            <div>
              <label
                for="newsletter-email"
                class="text-foreground/80 text-sm font-medium"
              >
                Email Address
              </label>
              <input
                id="newsletter-email"
                name="email"
                type="email"
                placeholder="Enter your email address"
                class="border-border bg-muted/30 text-foreground placeholder:text-muted-foreground/50 focus:border-primary/40 mt-2 w-full rounded-xl border px-5 py-3.5 text-sm transition-all duration-300 outline-none disabled:opacity-60"
              />
              <p class="text-destructive mt-2 text-xs" data-error="email" hidden></p>
            </div>
            <p class="text-destructive text-xs" data-error="form" hidden></p>
            <button
              type="submit"
              id="newsletter-page-submit"
              class="group bg-primary text-primary-foreground hover:bg-primary/90 inline-flex w-full items-center justify-center gap-2.5 rounded-xl py-3.5 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] disabled:opacity-60"
            >
              <Send class="size-4" />
              Subscribe
            </button>
          </form>
        </div>
      </Reveal>

      <div class="relative order-first min-h-72 md:order-last">
        <Image
          field={cmsField(cmsPath, "image.url")}
          value={image.url}
          alt={image.alt}
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        <Reveal class="absolute right-6 bottom-6 left-6 text-white" delay={120}>
          <Heading3
            class="mb-2 font-serif text-2xl"
            field={cmsField(cmsPath, "overlay.heading")}
            value={overlay.heading}
          />
          <Text
            as="p"
            class="text-sm leading-relaxed text-white/85"
            field={cmsField(cmsPath, "overlay.text")}
            value={overlay.text}
          />
        </Reveal>
      </div>
    </div>
  </div>
</section>

<script>
  import { subscribeNewsletter } from "../../../lib/newsletter";

  // Re-run on astro:page-load (view transitions); bind once per form instance.
  function initNewsletterPageForm() {
    const form = document.getElementById("newsletter-page-form") as HTMLFormElement | null;
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;

    const success = document.getElementById("newsletter-page-success");
    const submitBtn = document.getElementById("newsletter-page-submit") as HTMLButtonElement | null;
    const successText = success?.querySelector<HTMLElement>("[data-success-text]");

    const setError = (name: string, msg: string | null) => {
      const el = form.querySelector<HTMLElement>(`[data-error="${name}"]`);
      const input = form.querySelector<HTMLElement>(`[name="${name}"]`);
      if (!el) return;
      if (msg) {
        el.textContent = msg;
        el.hidden = false;
        input?.setAttribute("aria-invalid", "true");
      } else {
        el.hidden = true;
        input?.removeAttribute("aria-invalid");
      }
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setError("email", null);
      setError("form", null);

      const email = String(new FormData(form).get("email") || "").trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError("email", "Please enter a valid email");
        return;
      }

      const original = submitBtn?.innerHTML;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Subscribing…";
      }
      const result = await subscribeNewsletter(email);
      if (submitBtn) {
        submitBtn.disabled = false;
        if (original !== undefined) submitBtn.innerHTML = original;
      }

      if (!result.ok) {
        setError(
          "form",
          result.error === "rate_limited"
            ? "Too many requests — please try again in a few minutes."
            : "Something went wrong. Please try again.",
        );
        return;
      }

      if (successText) {
        successText.textContent = result.alreadySubscribed
          ? "You're already on the list — thanks for your support!"
          : "Thanks for joining — watch your inbox for our next update.";
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    });
  }

  document.addEventListener("astro:page-load", initNewsletterPageForm);
</script>
