---
// Ports components/marketing/mentorship/eligibility.tsx
import Reveal from "../home/Reveal.astro";
import {
  Heading2,
  Text,
  Group,
  Item,
} from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  rules: string[];
}

const { eyebrow, title, description, rules } = Astro.props;
---

<section class="bg-foreground/[0.02] py-28 md:py-40">
  <div class="container">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-32">
      <Reveal>
        <div>
          <Text
            as="p"
            class="text-primary mb-6 text-xs font-semibold tracking-[0.3em] uppercase"
            field={"eligibility.eyebrow"}
            value={eyebrow}
          />
          <Heading2
            class="font-serif text-4xl leading-[1.1] md:text-5xl"
            field={"eligibility.title"}
            value={title}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-6 text-base leading-relaxed"
            field={"eligibility.description"}
            value={description}
          />
        </div>
      </Reveal>

      <Reveal delay={120}>
        <Group field={"eligibility.rules"} class="space-y-3">
          {
            rules.map((rule, i) => (
              <Item
                index={i}
                as="div"
                class="group hover:border-primary/30 hover:bg-primary/[0.04] flex gap-5 rounded-2xl border border-transparent p-5 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
              >
                <span class="bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground flex size-11 shrink-0 items-center justify-center rounded-full font-serif text-lg transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {i === 3 ? (
                  <p
                    class="text-foreground/80 mt-1 text-sm leading-relaxed"
                    data-cms-field={`eligibility.rules.${i}`}
                    set:html={rule}
                  />
                ) : (
                  <Text
                    as="p"
                    class="text-foreground/80 mt-1 text-sm leading-relaxed"
                    field={`eligibility.rules.${i}`}
                    value={rule}
                  />
                )}
              </Item>
            ))
          }
        </Group>
      </Reveal>
    </div>
  </div>
</section>
