---
// Ports components/marketing/mentorship/intro.tsx
import Reveal from "../home/Reveal.astro";
import { Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  quote: string;
  paragraph: string;
  impactLabel: string;
  impactText: string;
  closing: string;
}

const { quote, paragraph, impactLabel, impactText, closing } = Astro.props;
---

<section class="pt-28 md:pt-40">
  <div class="container">
    <div class="mx-auto max-w-3xl space-y-10">
      <Reveal>
        <Text
          as="blockquote"
          class="border-primary/20 border-l-2 pl-8 font-serif text-2xl leading-relaxed italic md:text-3xl"
          field={"intro.quote"}
          value={quote}
        />
      </Reveal>
      <Reveal delay={80}>
        <Text
          as="p"
          class="text-muted-foreground leading-[1.8]"
          field={"intro.paragraph"}
          value={paragraph}
        />
      </Reveal>
      <Reveal delay={160}>
        <div class="border-primary/20 bg-primary/[0.04] rounded-2xl border p-8">
          <Text
            as="p"
            class="text-primary mb-4 text-xs font-semibold tracking-[0.3em] uppercase"
            field={"intro.impactLabel"}
            value={impactLabel}
          />
          <Text
            as="p"
            class="text-muted-foreground leading-[1.8]"
            field={"intro.impactText"}
            value={impactText}
          />
        </div>
      </Reveal>
      <Reveal delay={240}>
        <Text
          as="p"
          class="leading-[1.8] font-medium"
          field={"intro.closing"}
          value={closing}
        />
      </Reveal>
    </div>
  </div>
</section>
