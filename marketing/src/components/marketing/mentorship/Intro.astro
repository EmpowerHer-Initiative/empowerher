---
// Ports components/marketing/mentorship/intro.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  quote: string;
  paragraph: string;
  impactLabel: string;
  impactText: string;
  closing: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "intro"). */
  cmsPath?: string;
}

const { quote, paragraph, impactLabel, impactText, closing, cmsPath } = Astro.props;
---
<section class="pt-28 md:pt-40">
  <div class="container">
    <div class="mx-auto max-w-3xl space-y-10">
      <Reveal>
        <blockquote class="border-primary/20 border-l-2 pl-8 font-serif text-2xl leading-relaxed italic md:text-3xl" data-cms-field={cmsField(cmsPath, "quote")}>
          {quote}
        </blockquote>
      </Reveal>
      <Reveal delay={80}>
        <p class="text-muted-foreground leading-[1.8]" data-cms-field={cmsField(cmsPath, "paragraph")}>
          {paragraph}
        </p>
      </Reveal>
      <Reveal delay={160}>
        <div class="border-primary/20 bg-primary/[0.04] rounded-2xl border p-8">
          <p class="text-primary mb-4 text-xs font-semibold tracking-[0.3em] uppercase" data-cms-field={cmsField(cmsPath, "impactLabel")}>
            {impactLabel}
          </p>
          <p class="text-muted-foreground leading-[1.8]" data-cms-field={cmsField(cmsPath, "impactText")}>
            {impactText}
          </p>
        </div>
      </Reveal>
      <Reveal delay={240}>
        <p class="leading-[1.8] font-medium" data-cms-field={cmsField(cmsPath, "closing")}>
          {closing}
        </p>
      </Reveal>
    </div>
  </div>
</section>
