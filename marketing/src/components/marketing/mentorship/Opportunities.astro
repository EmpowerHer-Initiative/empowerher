---
// Ports components/marketing/mentorship/opportunities.tsx
import ArrowRight from "../../icons/ArrowRight.astro";
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";
import { Heading3, Text } from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  title: string;
  titleLine2: string;
  items: { title: string; description: string }[];
  note: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "opportunities"). */
  cmsPath?: string;
}

const { eyebrow, title, titleLine2, items, note, cmsPath } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <Reveal>
      <div class="mb-16">
        <Text
          as="p"
          class="text-primary mb-4 text-xs font-semibold tracking-[0.3em] uppercase"
          field={cmsField(cmsPath, "eyebrow")}
          value={eyebrow}
        />
        <h2 class="font-serif text-4xl leading-[1.1] md:text-5xl">
          <Text as="span" field={cmsField(cmsPath, "title")} value={title} />
          <br />
          <Text as="span" field={cmsField(cmsPath, "titleLine2")} value={titleLine2} />
        </h2>
      </div>
    </Reveal>

    <Reveal delay={160}>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="border-border bg-background hover:border-primary/30 rounded-2xl border p-10 shadow-sm transition-colors">
          <p class="text-primary/40 font-serif text-5xl">01</p>
          <Heading3
            class="mt-6 text-xl font-semibold"
            field={cmsField(cmsPath, "items.0.title")}
            value={items[0].title}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-3 text-sm leading-relaxed"
            field={cmsField(cmsPath, "items.0.description")}
            value={items[0].description}
          />
          <a
            href="/success-stories/spr"
            class="text-primary hover:text-primary/80 mt-6 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
          >
            Student Project Roadmap (SPR)
            <ArrowRight class="size-3.5" />
          </a>
        </div>

        <div class="border-border bg-background hover:border-primary/30 rounded-2xl border p-10 shadow-sm transition-colors">
          <p class="text-primary/40 font-serif text-5xl">02</p>
          <Heading3
            class="mt-6 text-xl font-semibold"
            field={cmsField(cmsPath, "items.1.title")}
            value={items[1].title}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-3 text-sm leading-relaxed"
            field={cmsField(cmsPath, "items.1.description")}
            value={items[1].description}
          />
          <a
            href="/hervoice"
            class="text-primary hover:text-primary/80 mt-6 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
          >
            Explore HerVoice
            <ArrowRight class="size-3.5" />
          </a>
        </div>

        <div class="border-border bg-background hover:border-primary/30 rounded-2xl border p-10 shadow-sm transition-colors">
          <p class="text-primary/40 font-serif text-5xl">03</p>
          <Heading3
            class="mt-6 text-xl font-semibold"
            field={cmsField(cmsPath, "items.2.title")}
            value={items[2].title}
          />
          <Text
            as="p"
            class="text-muted-foreground mt-3 text-sm leading-relaxed"
            field={cmsField(cmsPath, "items.2.description")}
            value={items[2].description}
          />
        </div>
      </div>
    </Reveal>

    <Reveal delay={240}>
      <Text
        as="p"
        class="text-muted-foreground mt-10 text-sm leading-relaxed"
        field={cmsField(cmsPath, "note")}
        value={note}
      />
    </Reveal>
  </div>
</section>
