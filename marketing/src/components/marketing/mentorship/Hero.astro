---
// Ports components/marketing/mentorship/hero.tsx
import ArrowRight from "../../icons/ArrowRight.astro";
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  title: string;
  titleLine2: string;
  image: string;
  imageAlt: string;
  paragraphs: string[];
}

const { eyebrow, title, titleLine2, image, imageAlt, paragraphs } = Astro.props;
---
<section class="relative overflow-hidden py-28 md:py-40">
  <img
    src={image}
    alt={imageAlt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/30"></div>
  <div class="relative container">
    <div class="mx-auto max-w-4xl">
      <Reveal>
        <p class="mb-8 text-xs font-semibold tracking-[0.3em] text-white/70 uppercase">
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="font-serif text-5xl leading-[1.05] text-white md:text-7xl lg:text-8xl">
          {title}
          <br />
          {titleLine2}
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-20">
          {paragraphs.map((paragraph) => (
            <p class="text-lg leading-relaxed text-white/75">{paragraph}</p>
          ))}
        </div>
      </Reveal>
      <Reveal delay={240}>
        <div class="mt-14 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href="#workshops"
            class="group inline-flex items-center gap-2.5 rounded-full bg-white px-8 py-4 text-sm font-semibold text-black transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-white/90 active:scale-[0.98]"
          >
            Find Workshop Applications Here
            <ArrowRight class="size-4 transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5" />
          </a>
        </div>
      </Reveal>
    </div>
  </div>
</section>
