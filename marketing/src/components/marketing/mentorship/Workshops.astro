---
// Ports the Workshops section from app/(marketing)/mentorship/page.tsx.
// Source fetches caller.workshops.list() (fields: id, name, mentors[],
// description, image, link). MOCK: representative sample hardcoded inline.
import ExternalLink from "../../icons/ExternalLink.astro";
import Reveal from "../home/Reveal.astro";

interface Props {
  items: {
    name: string;
    mentors: string[];
    description: string;
    image: string;
    link: string;
  }[];
}

const { items } = Astro.props;
---

<section
  id="workshops"
  class="bg-foreground/[0.02] scroll-mt-20 py-28 md:py-40 lg:scroll-mt-24"
>
  <div class="container">
    <div
      class="mb-16 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <Reveal>
        <div>
          <p
            class="text-primary mb-4 text-xs font-semibold tracking-[0.3em] uppercase"
          >
            Apply Now
          </p>
          <h2 class="font-serif text-4xl leading-[1.1] md:text-5xl">
            Available Workshops
          </h2>
        </div>
      </Reveal>
    </div>

    {/* Alternating image-left / image-right layout */}
      <div class="space-y-6" data-collection="workshops">
        {
          items.map((workshop, i) => (
            <Reveal>
              <div
                class={`group border-border/40 bg-background hover:border-primary/20 hover:shadow-primary/5 flex flex-col overflow-hidden rounded-3xl border transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-xl ${
                  i % 2 !== 0 ? "md:flex-row-reverse" : "md:flex-row"
                }`}
              >
                {/* Image */}
                <div class="relative aspect-video overflow-hidden md:aspect-auto md:w-2/5 md:shrink-0">
                  <img
                    src={workshop.image}
                    alt={workshop.name}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-105"
                  />
                </div>
                {/* Details */}
                <div class="flex flex-col justify-center gap-6 p-8 md:p-12 lg:p-14">
                  <div>
                    {workshop.mentors.length > 0 && (
                      <p class="text-primary mb-3 text-xs font-semibold tracking-[0.3em] uppercase">
                        Mentor — {workshop.mentors.join(", ")}
                      </p>
                    )}
                    <h3 class="text-2xl leading-snug font-semibold md:text-3xl">
                      {workshop.name}
                    </h3>
                    <p class="text-muted-foreground mt-4 text-base leading-relaxed">
                      {workshop.description}
                    </p>
                  </div>
                  <a
                    href={workshop.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex w-fit items-center gap-2 rounded-full px-7 py-3 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg active:scale-[0.98]"
                  >
                    Apply Here
                    <ExternalLink class="size-3.5" />
                  </a>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
  </div>
</section>
