---
// Ports components/marketing/hervoice-winners/honorable-mentions.tsx
import Reveal from "../home/Reveal.astro";
import {
  Heading2,
  Heading3,
  Image,
  Group,
  Item,
} from "@alisamadiillc/cms-bridge/components";

interface Mention {
  name: string;
  title: string;
  image: string;
  slug: string;
}
interface Props {
  title: string;
  mentions: Mention[];
}
const { title, mentions } = Astro.props;
---

<section class="bg-[#FAF6EE] px-6 py-16 md:py-24">
  <div class="mx-auto max-w-5xl">
    <Reveal>
      <Heading2
        class="text-center font-serif text-3xl font-bold tracking-tight md:text-4xl"
        field={"honorableMentions.title"}
        value={title}
      />
    </Reveal>

    <Reveal>
      <Group
        field={"honorableMentions.mentions"}
        class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3"
      >
        {
          mentions.map((story, i) => (
            <Item
              index={i}
              as="a"
              href={`/hervoice/${story.slug}`}
              class="group relative overflow-hidden rounded-2xl border border-[#ECE3D2] bg-white shadow-[0_12px_32px_-16px_rgba(26,34,48,.35)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_44px_-18px_rgba(26,34,48,.45)]"
            >
              <div class="relative aspect-[4/3] overflow-hidden">
                <Image
                  field={`honorableMentions.mentions.${i}.image`}
                  value={story.image}
                  alt={story.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
              </div>
              <div class="p-5">
                <Heading3
                  class="font-serif text-lg font-bold text-[#1A2230]"
                  field={`honorableMentions.mentions.${i}.title`}
                  value={story.title}
                />
                {/* "by " prefix is literal, not part of the `name` field value — kept hand-tagged. */}
                <p
                  class="mt-1 text-sm text-[#6B7686]"
                  data-cms-field={`honorableMentions.mentions.${i}.name`}
                >
                  by {story.name}
                </p>
              </div>
            </Item>
          ))
        }
      </Group>
    </Reveal>
  </div>
</section>
