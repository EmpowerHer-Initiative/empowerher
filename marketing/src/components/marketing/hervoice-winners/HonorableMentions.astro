---
// Ports components/marketing/hervoice-winners/honorable-mentions.tsx
import Reveal from "../home/Reveal.astro";

const mentions = [
  {
    name: "Khadija Mohammadi",
    title: "The Girl Who Studied in the Dark",
    image:
      "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPT5IuYoRWxDjwpl6zcWuZFSE0gC1TOnBMHdPh3",
    slug: "the-girl-who-studied-in-the-dark",
  },
  {
    name: "Mohadisa Bazel",
    title: "Running Towards Freedom",
    image:
      "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPT6gmlzi49jfnexowH4rdvO7pcMmglFtNsyY50",
    slug: "running-towards-freedom",
  },
  {
    name: "Spogmai Sharifi",
    title: "The Day I Said No",
    image:
      "https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPTpZTtiPVqrM0zsm5gThJ2eDxZtjCFUdBGElvb",
    slug: "the-day-i-said-no",
  },
];
---

<section class="bg-[#FAF6EE] px-6 py-16 md:py-24">
  <div class="mx-auto max-w-5xl">
    <Reveal>
      <h2
        class="text-center font-serif text-3xl font-bold tracking-tight md:text-4xl"
      >
        Writings from Honorable Mention Winners
      </h2>
    </Reveal>

    <Reveal>
      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          mentions.map((story) => (
            <a
              href={`/hervoice/${story.slug}`}
              class="group relative overflow-hidden rounded-2xl border border-[#ECE3D2] bg-white shadow-[0_12px_32px_-16px_rgba(26,34,48,.35)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_44px_-18px_rgba(26,34,48,.45)]"
            >
              <div class="relative aspect-[4/3] overflow-hidden">
                <img
                  src={story.image}
                  alt={story.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" />
              </div>
              <div class="p-5">
                <h3 class="font-serif text-lg font-bold text-[#1A2230]">
                  {story.title}
                </h3>
                <p class="mt-1 text-sm text-[#6B7686]">by {story.name}</p>
              </div>
            </a>
          ))
        }
      </div>
    </Reveal>
  </div>
</section>
