---
// Ports HerVoiceCTA from components/hervoice/shared.tsx (default props).
import { cmsField } from "../../../lib/cms";
import { Heading2, Text } from "@alisamadiillc/cms-bridge/components";
interface Props {
  heading: string;
  bodyText: string;
  /** CMS field path prefix for live-preview highlighting (e.g. "herVoiceCta"). */
  cmsPath?: string;
}
const { heading, bodyText, cmsPath } = Astro.props;
---
<section class="px-6 py-12 md:py-16">
  <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl bg-[linear-gradient(135deg,#1E78C4,#2E9BE6)] px-8 py-10 md:flex md:items-center md:justify-between md:px-12 md:py-12">
    <div>
      <Heading2 class="text-2xl font-bold text-white md:text-3xl" field={cmsField(cmsPath, "heading")} value={heading} />
      <Text
        as="p"
        class="mt-2 max-w-lg text-[15px] leading-relaxed text-white/70"
        field={cmsField(cmsPath, "bodyText")}
        value={bodyText}
      />
    </div>
    <a
      href="/hervoice"
      class="group/cta mt-6 inline-flex items-center gap-2 text-[15px] font-bold whitespace-nowrap text-white underline decoration-[#E0AE3C] decoration-2 underline-offset-4 transition-colors hover:text-[#E0AE3C] md:mt-0"
    >
      Read More
      <svg class="transition-transform group-hover/cta:translate-x-1" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
