---
// Ports app/(marketing)/get-involved/partner-with-us/page.tsx (visual-only, default form state)
import ArrowLeft from "../../icons/ArrowLeft.astro";
import Reveal from "../home/Reveal.astro";
import PartnerForm from "./PartnerForm.astro";

const email = "info@empowerher-initiative.org";
---

<div class="min-h-screen lg:flex">
  {
    /* ── Left panel — brand messaging ─────────────────────────────────────── */
  }
  <div
    class="bg-muted text-foreground relative flex flex-col justify-between overflow-hidden px-10 py-16 md:px-14 lg:w-[45%] lg:px-16 lg:py-24"
  >
    {/* Background image subtle overlay */}
    <div class="absolute inset-0 opacity-10">
      <img
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover"
        src="https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPT3hSLjjKpPsIbjXnuoAM3O2JygVY8KzGFtD6k"
        alt=""
      />
    </div>

    <Reveal class="relative">
      <a
        href="/get-involved"
        class="group text-muted-foreground hover:text-foreground mb-12 inline-flex items-center gap-2 text-sm font-medium transition-colors"
      >
        <ArrowLeft
          class="size-4 transition-transform duration-300 group-hover:-translate-x-0.5"
        />
        Back
      </a>

      <p
        class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Organizations &amp; Companies
      </p>
      <h1 class="mt-4 font-serif text-4xl leading-[1.1] md:text-5xl">
        Partner With Us
      </h1>
      <p class="text-muted-foreground mt-6 text-base leading-relaxed">
        Organizations and companies aligned with our mission and vision, or
        those interested in supporting our work, are encouraged to complete the
        form below. A member of our team will be in touch to explore potential
        partnership opportunities.
      </p>
    </Reveal>

    <Reveal delay={120} class="border-border relative mt-16 border-t pt-8">
      <p class="text-muted-foreground text-xs">
        Questions?{" "}
        <a
          href={`mailto:${email}`}
          class="text-muted-foreground underline-offset-2 hover:underline"
        >
          {email}
        </a>
      </p>
    </Reveal>
  </div>

  {
    /* ── Right panel — form ───────────────────────────────────────────────── */
  }
  <div
    class="flex flex-1 flex-col justify-center px-8 py-16 md:px-14 lg:px-16 lg:py-24"
  >
    <Reveal class="mx-auto w-full max-w-lg">
      <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
        Partnership Inquiry
      </p>
      <h2 class="mt-4 font-serif text-3xl md:text-4xl">
        Tell us about your organization
      </h2>
      <p class="text-muted-foreground mt-3 text-sm">
        All fields marked with <span class="text-primary">*</span>{" "}
        are required.
      </p>

      <div class="mt-10">
        <PartnerForm />
      </div>
    </Reveal>
  </div>
</div>
