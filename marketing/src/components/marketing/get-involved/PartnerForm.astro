---
// Ports components/marketing/partner-with-us/partner-form.tsx (visual-only, no submit handler)
import ArrowRight from "../../icons/ArrowRight.astro";
import { Heading2, Text } from "@alisamadiillc/cms-bridge/components";
import pages from "../../../data/pages.json";
const content = pages["get-involved-partner"];

const inputClass =
  "w-full rounded-xl border bg-background px-4 py-3 text-sm outline-none transition-all duration-300 placeholder:text-muted-foreground/40 focus:border-primary/40 focus:ring-2 focus:ring-primary/10 border-border/60";
---

<div
  id="partner-success"
  class="border-border/40 bg-primary/[0.03] hidden space-y-4 rounded-2xl border p-8"
>
  <Heading2 class="font-serif text-2xl" field="title2" value={content.title2} />
  <Text
    as="p"
    class="text-muted-foreground text-base leading-[1.8]"
    field="text"
    value={content.text}
  />
  <button
    type="button"
    id="partner-reset"
    class="text-primary text-sm font-medium underline-offset-4 hover:underline"
  >
    Submit another inquiry
  </button>
</div>

<form id="partner-form" class="space-y-6" novalidate>
  {/* Honeypot — real users never see this; bots fill it and the server drops the send. */}
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="hidden"
  />
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="space-y-2">
      <label for="firstName" class="text-foreground/80 text-sm font-medium">
        First Name <span class="text-primary">*</span>
      </label>
      <input
        id="firstName"
        name="firstName"
        type="text"
        autocomplete="given-name"
        placeholder="Nahid"
        class={inputClass}
      />
    </div>
    <div class="space-y-2">
      <label for="lastName" class="text-foreground/80 text-sm font-medium">
        Last Name <span class="text-primary">*</span>
      </label>
      <input
        id="lastName"
        name="lastName"
        type="text"
        autocomplete="family-name"
        placeholder="Karimi"
        class={inputClass}
      />
    </div>
  </div>

  <div class="space-y-2">
    <label for="businessEmail" class="text-foreground/80 text-sm font-medium">
      Business Email Address <span class="text-primary">*</span>
    </label>
    <input
      id="businessEmail"
      name="businessEmail"
      type="email"
      autocomplete="email"
      placeholder="you@organization.org"
      class={inputClass}
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="space-y-2">
      <label for="position" class="text-foreground/80 text-sm font-medium">
        Your Position <span class="text-primary">*</span>
      </label>
      <input
        id="position"
        name="position"
        type="text"
        placeholder="Executive Director"
        class={inputClass}
      />
    </div>
    <div class="space-y-2">
      <label for="organization" class="text-foreground/80 text-sm font-medium">
        Organization / Company <span class="text-primary">*</span>
      </label>
      <input
        id="organization"
        name="organization"
        type="text"
        placeholder="Your Organization"
        class={inputClass}
      />
    </div>
  </div>

  <div class="space-y-2">
    <label for="message" class="text-foreground/80 text-sm font-medium">
      Message <span class="text-primary">*</span>
    </label>
    <p class="text-muted-foreground text-xs">
      Please tell us briefly about your company/organization and how your
      company/organization can join us as a partner and support us
    </p>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Tell us about your organization and how you'd like to partner with EmpowerHer..."
      class="bg-background placeholder:text-muted-foreground/40 focus:border-primary/40 focus:ring-primary/10 border-border/60 w-full resize-none rounded-xl border px-4 py-3 text-sm transition-all duration-300 outline-none focus:ring-2"
    ></textarea>
  </div>

  <button
    type="submit"
    id="partner-submit"
    class="group bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex w-full items-center justify-center gap-2 rounded-full px-8 py-4 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg active:scale-[0.98] disabled:opacity-70"
  >
    Submit Partnership Inquiry
    <span
      class="bg-primary-foreground/15 flex size-6 items-center justify-center rounded-full transition-transform duration-500 group-hover:translate-x-0.5"
    >
      <ArrowRight class="size-3.5" />
    </span>
  </button>
  <p class="text-destructive text-sm" data-error="form" hidden></p>
</form>

<script>
  function initPartnerForm() {
    const form = document.getElementById(
      "partner-form",
    ) as HTMLFormElement | null;
    if (!form || (form as any).__bound) return;
    (form as any).__bound = true;

    const success = document.getElementById("partner-success");
    const submitBtn = document.getElementById(
      "partner-submit",
    ) as HTMLButtonElement | null;
    const formErr = form.querySelector<HTMLElement>('[data-error="form"]');

    const setFormError = (msg: string | null) => {
      if (!formErr) return;
      if (msg) {
        formErr.textContent = msg;
        formErr.hidden = false;
      } else {
        formErr.hidden = true;
      }
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      setFormError(null);
      const data = new FormData(form);
      const firstName = String(data.get("firstName") || "").trim();
      const lastName = String(data.get("lastName") || "").trim();
      const businessEmail = String(data.get("businessEmail") || "").trim();
      const position = String(data.get("position") || "").trim();
      const organization = String(data.get("organization") || "").trim();
      const message = String(data.get("message") || "").trim();

      if (!firstName || !lastName || !position || !organization) {
        setFormError("Please fill in all required fields.");
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(businessEmail)) {
        setFormError("Please enter a valid business email.");
        return;
      }
      if (message.length < 10) {
        setFormError("Please tell us a little more (at least 10 characters).");
        return;
      }
      const originalBtn = submitBtn?.innerHTML;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }
      let failed: string | null = null;
      try {
        const res = await fetch("/api/partner", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: `${firstName} ${lastName}`.trim(),
            email: businessEmail,
            organization,
            position,
            message,
            company: String(data.get("company") || ""),
          }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => null);
          failed = err?.error || "Something went wrong — please try again.";
        }
      } catch {
        failed = "Network error — please try again.";
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        if (originalBtn !== undefined) submitBtn.innerHTML = originalBtn;
      }

      if (failed) {
        setFormError(failed);
        return;
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
    });

    document.getElementById("partner-reset")?.addEventListener("click", () => {
      form.reset();
      success?.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  document.addEventListener("astro:page-load", initPartnerForm);
</script>
