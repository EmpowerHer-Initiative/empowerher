---
// Ports components/marketing/annual-report/header.tsx
import Reveal from "../home/Reveal.astro";
---

<section class="py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <p
          class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Transparency &amp; Impact
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl">
          Annual Impact Reports
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <p
          class="text-muted-foreground mt-8 max-w-xl text-base leading-relaxed md:text-lg"
        >
          Each year we document the reach and outcomes of our programs — the
          girls we've supported, the stories we've amplified, and the
          communities we've strengthened. These reports hold us accountable to
          our mission.
        </p>
      </Reveal>
    </div>
  </div>
</section>
