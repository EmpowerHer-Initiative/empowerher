---
// Ports components/marketing/annual-report/header.tsx
import Reveal from "../home/Reveal.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  /** CMS field path prefix for live-preview highlighting. */
  cmsPath?: string;
}
const { eyebrow, heading, body, cmsPath } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="max-w-3xl">
      <Reveal>
        <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase" data-cms-field={cmsField(cmsPath, "eyebrow")}>
          {eyebrow}
        </p>
      </Reveal>
      <Reveal delay={80}>
        <h1 class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl" data-cms-field={cmsField(cmsPath, "heading")}>
          {heading}
        </h1>
      </Reveal>
      <Reveal delay={160}>
        <p class="text-muted-foreground mt-8 max-w-xl text-base leading-relaxed md:text-lg" data-cms-field={cmsField(cmsPath, "body")}>
          {body}
        </p>
      </Reveal>
    </div>
  </div>
</section>
