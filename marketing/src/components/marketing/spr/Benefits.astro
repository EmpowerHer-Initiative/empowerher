---
// Ports the Benefits section from app/(marketing)/success-stories/spr/page.tsx
import AlertCircle from "../../icons/AlertCircle.astro";
import ArrowRight from "../../icons/ArrowRight.astro";
import BriefcaseBusiness from "../../icons/BriefcaseBusiness.astro";
import Laptop from "../../icons/Laptop.astro";
import Network from "../../icons/Network.astro";
import TrendingUp from "../../icons/TrendingUp.astro";
import Users from "../../icons/Users.astro";
import Zap from "../../icons/Zap.astro";
import Reveal from "../home/Reveal.astro";

const items = [
  {
    title: "Hands-On Leadership Experience",
    description:
      "Gain practical skills in leading online classes and mentoring peers.",
  },
  {
    title: "Professional Development",
    description:
      "Learn how a nonprofit operates and develop communication, project management, and organizational skills.",
  },
  {
    title: "Direct Impact",
    description:
      "Expand educational access for Afghan girls through student-led initiatives.",
  },
  {
    title: "Mentorship & Guidance",
    description:
      "Receive structured support and feedback from EmpowerHer's experienced team throughout the roadmap.",
  },
  {
    title: "Resource & Networking Opportunities",
    description:
      "Use EmpowerHer's resources to enhance your skills and connect with a broader network.",
  },
  {
    title: "Promotion",
    description:
      "Based on strong workshop performance, dedication, and demonstrated leadership, EmpowerHer may offer talented members opportunities for promotion.",
  },
];

// Per-item icons stay in code, zipped to items by index.
const icons = [Laptop, BriefcaseBusiness, Zap, Users, Network, TrendingUp];
---

<section class="bg-foreground/[0.03] py-28 md:py-40">
  <div class="container">
    <Reveal class="mx-auto max-w-2xl">
      <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
        What You Gain
      </p>
      <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
        Roadmap Benefits
      </h2>
    </Reveal>

    <div class="mx-auto mt-16 max-w-2xl">
      <Reveal class="grid gap-5 sm:grid-cols-2" delay={80}>
        <div class="contents">
          {
            items.map((benefit, i) => {
              const Icon = icons[i % icons.length];
              return (
                <div class="group border-border/60 bg-background hover:border-primary/30 hover:shadow-primary/5 flex gap-5 rounded-2xl border p-7 shadow-sm transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-1 hover:shadow-lg">
                  <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
                    <Icon class="size-5" />
                  </div>
                  <div>
                    <h3 class="text-base font-semibold">{benefit.title}</h3>
                    <p class="text-foreground/70 mt-2 text-sm leading-relaxed">
                      {benefit.description}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </Reveal>
    </div>

    {/* Volunteer note */}
    <Reveal class="mx-auto mt-12 max-w-2xl">
      <div
        class="flex gap-4 rounded-2xl border border-l-4 border-red-200 border-l-red-600 bg-red-50 p-6"
      >
        <AlertCircle class="mt-0.5 size-5 shrink-0 text-red-600" />
        <div>
          <p class="text-sm font-semibold text-red-800">Important Note</p>
          <p class="text-foreground/80 mt-1.5 text-sm leading-relaxed">
            EmpowerHer does not provide a monthly salary for its staff members.
            All roles within this roadmap are volunteer-based. Participation as
            an Assistant or Mentor is completely free, and no monetary
            compensation is provided.
          </p>
        </div>
      </div>
    </Reveal>

    <Reveal class="mx-auto mt-10 max-w-2xl text-center" delay={80}>
      <a
        href="mailto:apply@empowerher-initiative.org"
        class="group bg-foreground text-background hover:shadow-foreground/10 inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-lg active:scale-[0.98]"
      >
        Apply Now
        <span
          class="bg-background/10 flex size-6 items-center justify-center rounded-full transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5"
        >
          <ArrowRight class="size-3.5" />
        </span>
      </a>
    </Reveal>
  </div>
</section>
