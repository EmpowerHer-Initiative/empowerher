---
// Ports the Hero section from app/(marketing)/success-stories/spr/page.tsx
import ArrowLeft from "../../icons/ArrowLeft.astro";
import Reveal from "../home/Reveal.astro";
---

<section class="relative overflow-hidden">
  {/* Full-bleed image behind */}
  <div class="absolute inset-0">
    <img
      src="https://3625xubr2k.ufs.sh/f/yiXnwfSQWCPTqmNmG6BYobifLHTavDVU7h0yBGlSc4z8XEQn"
      alt=""
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <div class="bg-foreground/70 absolute inset-0"></div>
  </div>

  <div class="relative container py-28 md:py-40">
    <Reveal>
      <a
        href="/success-stories"
        class="group text-background/60 hover:text-background mb-10 inline-flex items-center gap-2 text-sm font-medium transition-colors"
      >
        <ArrowLeft
          class="size-4 transition-transform duration-300 group-hover:-translate-x-0.5"
        />
        Back to Success Stories
      </a>
    </Reveal>

    <Reveal class="max-w-2xl" delay={120}>
      <p
        class="text-background/50 text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Leadership Pathway
      </p>
      <h1
        class="text-background mt-5 font-serif text-5xl leading-[1.05] md:text-6xl lg:text-7xl"
      >
        Student Project Roadmap (SPR)
      </h1>
      <p
        class="text-background/75 mt-8 max-w-xl text-base leading-relaxed md:text-lg"
      >
        The Student Project Roadmap (SPR) is a leadership pathway for EmpowerHer
        students who have completed their workshops and met eligibility
        requirements and wish to deepen their practical leadership experience.
        Through a structured, step-by-step process, students work closely with
        EmpowerHer's team to design and lead their own impact-driven online
        classes, directly advancing EmpowerHer's mission and expanding
        educational access for more Afghan girls.
      </p>
    </Reveal>
  </div>
</section>
