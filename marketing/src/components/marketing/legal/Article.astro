---
// Ports components/marketing/legal/_shared.tsx (Article).
import { cmsField } from "../../../lib/cms";
import { Heading2, Text } from "@alisamadiillc/cms-bridge/components";
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  /** CMS field path prefix for this part (e.g. "body.parts.0"). */
  cmsPath?: string;
}
const { id, eyebrow, title, cmsPath } = Astro.props;
---
<section id={id} class="border-border/30 scroll-mt-32 border-t py-16">
  <div class="grid gap-8 md:grid-cols-12">
    <div class="md:col-span-4">
      <Text
        as="p"
        class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
        field={cmsField(cmsPath, "eyebrow")}
        value={eyebrow}
      />
      <Heading2
        class="mt-3 font-serif text-2xl leading-tight md:text-3xl"
        field={cmsField(cmsPath, "title")}
        value={title}
      />
    </div>
    <div class="text-muted-foreground space-y-4 text-sm leading-[1.9] md:col-span-8">
      <slot />
    </div>
  </div>
</section>
