---
// Ports components/marketing/legal/legal-body.tsx.
import Reveal from "../home/Reveal.astro";
import Article from "./Article.astro";

interface Part {
  eyebrow: string;
  title: string;
  paragraphs: string[];
}

const parts: Part[] = [
  {
    eyebrow: "Part One",
    title: "Terms of Use",
    paragraphs: [
      "Terms of Use content coming soon. This section will outline the rules and conditions for using the EmpowerHer website, programs, and services.",
    ],
  },
  {
    eyebrow: "Part Two",
    title: "Privacy Policy",
    paragraphs: [
      "Privacy Policy content coming soon. This section will describe what information we collect, how we use it, and the choices you have over your data.",
    ],
  },
];

const footer = {
  updated: "Last updated: 2026.",
  contactPrompt: "Questions? Email",
  email: "info@empowerher-initiative.org",
};

const sectionIds = ["terms", "privacy"];
---

<div class="container pb-32">
  <div class="mx-auto max-w-5xl">
    {
      parts.map((part, i) => (
        <Reveal>
          <Article id={sectionIds[i]} eyebrow={part.eyebrow} title={part.title}>
            {part.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </Article>
        </Reveal>
      ))
    }

    <div class="border-border/30 text-muted-foreground border-t pt-10 text-xs">
      {footer.updated}
      {footer.contactPrompt}{" "}
      <a
        href={`mailto:${footer.email}`}
        class="text-foreground underline-offset-4 hover:underline"
        >{footer.email}</a
      >
      .
    </div>
  </div>
</div>
