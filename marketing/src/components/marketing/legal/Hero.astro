---
// Ports components/marketing/legal/hero.tsx.
import Reveal from "../home/Reveal.astro";
---

<section class="py-28 md:py-40">
  <div class="container">
    <Reveal class="max-w-4xl">
      <p
        class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Legal
      </p>
      <h1 class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl">
        Terms <span class="cms-hl italic">&amp;</span> Privacy
      </h1>
      <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed">
        How we operate, what we expect, and how we protect the information you
        share with the EmpowerHer Initiative.
      </p>
    </Reveal>
  </div>
</section>
