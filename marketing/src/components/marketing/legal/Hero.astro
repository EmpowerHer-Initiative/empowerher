---
// Ports components/marketing/legal/hero.tsx.
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  headingLead: string;
  headingTrail: string;
  body: string;
}
const { eyebrow, headingLead, headingTrail, body } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <Reveal class="max-w-4xl">
      <p class="text-muted-foreground text-xs font-semibold tracking-[0.3em] uppercase">
        {eyebrow}
      </p>
      <h1 class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl">
        {headingLead} <span class="text-primary italic">&</span> {headingTrail}
      </h1>
      <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed">
        {body}
      </p>
    </Reveal>
  </div>
</section>
