---
// Ports components/marketing/writing-contest/hero.tsx
import Reveal from "../home/Reveal.astro";
import ExternalLink from "../../icons/ExternalLink.astro";
import { cmsField } from "../../../lib/cms";

const FORM_URL = "https://forms.gle/J5D6atwg4cH5yicf9";

interface Props {
  eyebrow: string;
  heading: string;
  paragraph: string;
  calloutText: string;
  calloutName: string;
  image: { src: string; alt: string };
  cmsPath?: string;
}
const { eyebrow, heading, paragraph, calloutText, calloutName, image, cmsPath } =
  Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="grid items-center gap-16 lg:grid-cols-[1fr_1fr]">
      <Reveal class="max-w-xl">
        <p
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          data-cms-field={cmsField(cmsPath, "eyebrow")}
        >
          {eyebrow}
        </p>
        <h1
          class="mt-5 font-serif text-5xl leading-[1.05] md:text-7xl"
          data-cms-field={cmsField(cmsPath, "heading")}
        >
          {heading}
        </h1>
        <p
          class="text-muted-foreground mt-8 text-base leading-relaxed md:text-lg"
          data-cms-field={cmsField(cmsPath, "paragraph")}
        >
          {paragraph}
        </p>
        <div class="border-primary/30 bg-primary/[0.05] border-l-primary mt-8 rounded-2xl border border-l-4 p-5">
          <p
            class="text-foreground text-sm leading-relaxed"
            data-cms-field={cmsField(cmsPath, "calloutText")}
          >
            {calloutText}{" "}
            <span class="font-semibold" data-cms-field={cmsField(cmsPath, "calloutName")}>{calloutName}</span>.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={FORM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-primary text-primary-foreground hover:shadow-primary/25 inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 text-sm font-semibold transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.98]"
          >
            Submit Your Entry
            <ExternalLink class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
          </a>
          <a
            href="/hervoice"
            class="border-border/60 text-foreground/70 hover:border-primary hover:text-foreground inline-flex items-center gap-2 rounded-full border px-7 py-3.5 text-sm font-medium transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
          >
            Explore HerVoice
          </a>
        </div>
      </Reveal>

      <Reveal class="border-border/30 overflow-hidden rounded-3xl border" delay={120}>
        <img
          src={image.src}
          alt={image.alt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-cms-field={cmsField(cmsPath, "image.src")}
          class="aspect-[4/3] h-full w-full object-cover"
        />
      </Reveal>
    </div>
  </div>
</section>
