---
// Ports components/marketing/writing-contest/about-contest.tsx
import Reveal from "../home/Reveal.astro";
import BookOpen from "../../icons/BookOpen.astro";

interface Props {
  title: string;
  paragraph: string;
}
const { title, paragraph } = Astro.props;
---
<section class="py-28 md:py-40">
  <div class="container">
    <Reveal class="mx-auto max-w-4xl">
      <h2 class="flex items-center gap-3 font-serif text-3xl leading-tight md:text-4xl">
        <BookOpen class="text-primary size-8 shrink-0" />
        {title}
      </h2>
      <p class="text-muted-foreground mt-8 text-lg leading-[1.8]">
        {paragraph}
      </p>
    </Reveal>
  </div>
</section>
