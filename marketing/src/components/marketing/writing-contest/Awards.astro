---
// Ports components/marketing/writing-contest/awards.tsx
import Reveal from "../home/Reveal.astro";
import Award from "../../icons/Award.astro";
import DollarSign from "../../icons/DollarSign.astro";
import Globe from "../../icons/Globe.astro";
import Star from "../../icons/Star.astro";
import Trophy from "../../icons/Trophy.astro";

const prizes = [
  {
    place: "1st Place",
    amount: "400",
  },
  {
    place: "2nd Place",
    amount: "300",
  },
  {
    place: "3rd Place",
    amount: "200",
  },
  {
    place: "4th Place",
    amount: "150",
  },
  {
    place: "5th Place",
    amount: "50",
  },
];

const recognitionBenefits = [
  {
    title: "Publication on HerVoice Platform",
    description:
      "All 5 cash prize winners and 3 honorable mentions will have their stories published on the HerVoice platform, sharing their voices with the wider EmpowerHer community.",
  },
  {
    title: "Featured on NSHSS Website",
    description:
      "Stories from the 1st, 2nd, and 3rd place winners will also be featured on our partner organization's website, The National Society of High School Scholars (NSHSS), reaching audiences in over 170 countries.",
  },
  {
    title: "Priority for Future Opportunities",
    description:
      "Cash prize winners and honorable mentions will be prioritized for future EmpowerHer workshops and opportunities to use our Student Project Roadmap to create their own impact projects. (Acceptance to workshops is not guaranteed, but their applications will receive priority consideration.)",
  },
  {
    title: "Cash Prizes",
    description:
      "Winners will receive cash prizes ranging from $50 to $400 USD to support their educational and personal development goals.",
  },
];

// Per-prize accent color is a style choice — kept in code, zipped by index.
const prizeAccents = [
  "text-amber-600 bg-amber-100",
  "text-slate-600 bg-slate-100",
  "text-orange-600 bg-orange-100",
  "text-emerald-600 bg-emerald-100",
  "text-violet-600 bg-violet-100",
];

// Per-benefit icon is chosen in code — zipped with editable text by index.
const benefitIcons = [Globe, Star, Award, DollarSign];
---

<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-5xl">
      <Reveal>
        <p
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Recognition
        </p>
        <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
          Awards & Recognition
        </h2>
        <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-relaxed">
          We carefully review all submissions with full consideration of each
          participant's circumstances. From this contest, we will select{" "}
          <span class="text-foreground font-semibold">5 winners</span> and{" "}
          <span class="text-foreground font-semibold">3 honorable mentions</span
          >
          .
        </p>
      </Reveal>

      {/* Prizes */}
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
        {
          prizes.map((prize, i) => (
            <Reveal
              class={`lg:col-span-2 ${i === 3 ? "lg:col-start-2" : ""} border-border/60 bg-background flex flex-col items-center rounded-3xl border p-8 text-center shadow-sm`}
              delay={i * 80}
            >
              <div>
                <div
                  class={`flex size-20 items-center justify-center rounded-full ${prizeAccents[i]}`}
                >
                  <Trophy class="size-9" />
                </div>
                <h3 class="mt-5 font-serif text-2xl">{prize.place}</h3>
                <p class="text-primary mt-2 font-serif text-5xl">
                  ${prize.amount}
                </p>
                <p class="text-muted-foreground mt-1 text-sm">US Dollars</p>
              </div>
            </Reveal>
          ))
        }
      </div>

      {/* Recognition benefits */}
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          recognitionBenefits.map((b, i) => {
            const Icon = benefitIcons[i];
            return (
              <Reveal
                class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm"
                delay={i * 80}
              >
                <div>
                  <div class="flex items-center gap-3">
                    <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
                      <Icon class="size-5" />
                    </div>
                    <h3 class="text-lg font-semibold">{b.title}</h3>
                  </div>
                  <p class="text-muted-foreground mt-4 text-base leading-relaxed">
                    {b.description}
                  </p>
                </div>
              </Reveal>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
