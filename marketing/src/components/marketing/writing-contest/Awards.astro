---
// Ports components/marketing/writing-contest/awards.tsx
import Reveal from "../home/Reveal.astro";
import Award from "../../icons/Award.astro";
import DollarSign from "../../icons/DollarSign.astro";
import Globe from "../../icons/Globe.astro";
import Star from "../../icons/Star.astro";
import Trophy from "../../icons/Trophy.astro";
import {
  Text,
  Heading2,
  Heading3,
  Group,
  Item,
} from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  title: string;
  introLead: string;
  introHighlight1: string;
  introHighlight2: string;
  prizes: { place: string; amount: string }[];
  recognitionBenefits: { title: string; description: string }[];
}
const {
  eyebrow,
  title,
  introLead,
  introHighlight1,
  introHighlight2,
  prizes,
  recognitionBenefits,
} = Astro.props;

// Per-prize accent color is a style choice — kept in code, zipped by index.
const prizeAccents = [
  "text-amber-600 bg-amber-100",
  "text-slate-600 bg-slate-100",
  "text-orange-600 bg-orange-100",
  "text-emerald-600 bg-emerald-100",
  "text-violet-600 bg-violet-100",
];

// Per-benefit icon is chosen in code — zipped with editable text by index.
const benefitIcons = [Globe, Star, Award, DollarSign];
---

<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-5xl">
      <Reveal>
        <Text
          as="p"
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          field={"awards.eyebrow"}
          value={eyebrow}
        />
        <Heading2
          class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl"
          field={"awards.title"}
          value={title}
        />
        {
          /* kept hand-tagged: paragraph mixes introLead + two highlighted spans + literal "and"/"." (multiple child elements) */
        }
        <p
          class="text-muted-foreground mt-6 max-w-2xl text-lg leading-relaxed"
          data-cms-field={"awards.introLead"}
        >
          {introLead}{" "}
          <Text
            as="span"
            class="text-foreground font-semibold"
            field={"awards.introHighlight1"}
            value={introHighlight1}
          /> and{" "}
          <Text
            as="span"
            class="text-foreground font-semibold"
            field={"awards.introHighlight2"}
            value={introHighlight2}
          />
          .
        </p>
      </Reveal>

      {/* Prizes */}
      <Group
        field={"awards.prizes"}
        class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-6"
      >
        {
          prizes.map((prize, i) => (
            <Reveal
              class={`lg:col-span-2 ${i === 3 ? "lg:col-start-2" : ""} border-border/60 bg-background flex flex-col items-center rounded-3xl border p-8 text-center shadow-sm`}
              delay={i * 80}
            >
              <Item index={i}>
                <div
                  class={`flex size-20 items-center justify-center rounded-full ${prizeAccents[i]}`}
                >
                  <Trophy class="size-9" />
                </div>
                <Heading3
                  class="mt-5 font-serif text-2xl"
                  field={`awards.prizes.${i}.place`}
                  value={prize.place}
                />
                {/* kept hand-tagged: content is literal "$" prefix + amount, not a single field value */}
                <p
                  class="text-primary mt-2 font-serif text-5xl"
                  data-cms-field={`awards.prizes.${i}.amount`}
                >
                  ${prize.amount}
                </p>
                <p class="text-muted-foreground mt-1 text-sm">US Dollars</p>
              </Item>
            </Reveal>
          ))
        }
      </Group>

      {/* Recognition benefits */}
      <Group
        field={"awards.recognitionBenefits"}
        class="mt-8 grid gap-6 md:grid-cols-2"
      >
        {
          recognitionBenefits.map((b, i) => {
            const Icon = benefitIcons[i];
            return (
              <Reveal
                class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm"
                delay={i * 80}
              >
                <Item index={i}>
                  <div class="flex items-center gap-3">
                    <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
                      <Icon class="size-5" />
                    </div>
                    <Heading3
                      class="text-lg font-semibold"
                      field={`awards.recognitionBenefits.${i}.title`}
                      value={b.title}
                    />
                  </div>
                  <Text
                    as="p"
                    class="text-muted-foreground mt-4 text-base leading-relaxed"
                    field={`awards.recognitionBenefits.${i}.description`}
                    value={b.description}
                  />
                </Item>
              </Reveal>
            );
          })
        }
      </Group>
    </div>
  </div>
</section>
