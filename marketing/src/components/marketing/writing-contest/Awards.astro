---
// Ports components/marketing/writing-contest/awards.tsx
import Reveal from "../home/Reveal.astro";
import Award from "../../icons/Award.astro";
import DollarSign from "../../icons/DollarSign.astro";
import Globe from "../../icons/Globe.astro";
import Star from "../../icons/Star.astro";
import Trophy from "../../icons/Trophy.astro";
import { cmsField } from "../../../lib/cms";

interface Props {
  eyebrow: string;
  title: string;
  introLead: string;
  introHighlight1: string;
  introHighlight2: string;
  prizes: { place: string; amount: string }[];
  recognitionBenefits: { title: string; description: string }[];
  cmsPath?: string;
}
const {
  eyebrow,
  title,
  introLead,
  introHighlight1,
  introHighlight2,
  prizes,
  recognitionBenefits,
  cmsPath,
} = Astro.props;

// Per-prize accent color is a style choice — kept in code, zipped by index.
const prizeAccents = [
  "text-amber-600 bg-amber-100",
  "text-slate-600 bg-slate-100",
  "text-orange-600 bg-orange-100",
  "text-emerald-600 bg-emerald-100",
  "text-violet-600 bg-violet-100",
];

// Per-benefit icon is chosen in code — zipped with editable text by index.
const benefitIcons = [Globe, Star, Award, DollarSign];
---
<section class="py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-5xl">
      <Reveal>
        <p
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          data-cms-field={cmsField(cmsPath, "eyebrow")}
        >
          {eyebrow}
        </p>
        <h2
          class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl"
          data-cms-field={cmsField(cmsPath, "title")}
        >
          {title}
        </h2>
        <p
          class="text-muted-foreground mt-6 max-w-2xl text-lg leading-relaxed"
          data-cms-field={cmsField(cmsPath, "introLead")}
        >
          {introLead}{" "}
          <span class="text-foreground font-semibold" data-cms-field={cmsField(cmsPath, "introHighlight1")}>{introHighlight1}</span> and{" "}
          <span class="text-foreground font-semibold" data-cms-field={cmsField(cmsPath, "introHighlight2")}>
            {introHighlight2}
          </span>
          .
        </p>
      </Reveal>

      {/* Prizes */}
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
        {prizes.map((prize, i) => (
          <Reveal
            class={`lg:col-span-2 ${i === 3 ? "lg:col-start-2" : ""} border-border/60 bg-background flex flex-col items-center rounded-3xl border p-8 text-center shadow-sm`}
            delay={i * 80}
          >
            <div class={`flex size-20 items-center justify-center rounded-full ${prizeAccents[i]}`}>
              <Trophy class="size-9" />
            </div>
            <h3 class="mt-5 font-serif text-2xl" data-cms-field={cmsField(cmsPath, `prizes.${i}.place`)}>{prize.place}</h3>
            <p class="text-primary mt-2 font-serif text-5xl" data-cms-field={cmsField(cmsPath, `prizes.${i}.amount`)}>
              ${prize.amount}
            </p>
            <p class="text-muted-foreground mt-1 text-sm">US Dollars</p>
          </Reveal>
        ))}
      </div>

      {/* Recognition benefits */}
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {recognitionBenefits.map((b, i) => {
          const Icon = benefitIcons[i];
          return (
            <Reveal class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm" delay={i * 80}>
              <div class="flex items-center gap-3">
                <div class="bg-primary/10 text-primary flex size-11 shrink-0 items-center justify-center rounded-xl">
                  <Icon class="size-5" />
                </div>
                <h3 class="text-lg font-semibold" data-cms-field={cmsField(cmsPath, `recognitionBenefits.${i}.title`)}>{b.title}</h3>
              </div>
              <p
                class="text-muted-foreground mt-4 text-base leading-relaxed"
                data-cms-field={cmsField(cmsPath, `recognitionBenefits.${i}.description`)}
              >
                {b.description}
              </p>
            </Reveal>
          );
        })}
      </div>
    </div>
  </div>
</section>
