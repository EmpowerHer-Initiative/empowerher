---
// Ports components/marketing/writing-contest/writing-prompt.tsx
import Reveal from "../home/Reveal.astro";
import Lightbulb from "../../icons/Lightbulb.astro";
---

<section class="bg-muted text-foreground py-28 md:py-40">
  <div class="container">
    <Reveal class="mx-auto max-w-4xl text-center">
      <Lightbulb class="text-primary mx-auto size-12" />
      <p
        class="text-primary mt-6 text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Writing Prompt / Theme
      </p>
      <div
        class="border-primary/20 bg-background mt-8 rounded-3xl border p-10 shadow-sm md:p-16"
      >
        <p class="font-serif text-3xl leading-snug md:text-4xl lg:text-5xl">
          “A time when you felt strength in being a woman/girl”
        </p>
      </div>
    </Reveal>
  </div>
</section>
