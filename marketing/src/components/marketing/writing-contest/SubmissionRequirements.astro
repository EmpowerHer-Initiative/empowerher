---
// Ports components/marketing/writing-contest/submission-requirements.tsx
import Reveal from "../home/Reveal.astro";
import AlertTriangle from "../../icons/AlertTriangle.astro";

interface Props {
  eyebrow: string;
  title: string;
  formatTitle: string;
  formatOptions: { title: string; description: string }[];
  formatWarning: string;
  rulesTitle: string;
  rules: string[];
}
const {
  eyebrow,
  title,
  formatTitle,
  formatOptions,
  formatWarning,
  rulesTitle,
  rules,
} = Astro.props;
---
<section class="bg-foreground/[0.025] py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-5xl">
      <Reveal>
        <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
        <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
          {title}
        </h2>
      </Reveal>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {/* Format options */}
        <Reveal class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm">
          <h3 class="font-serif text-2xl">{formatTitle}</h3>
          <div class="mt-6 space-y-4">
            {formatOptions.map((option) => (
              <div class="bg-muted/60 rounded-2xl p-6">
                <p class="text-foreground text-lg font-semibold">
                  {option.title}
                </p>
                <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
                  {option.description}
                </p>
              </div>
            ))}
            <div class="flex items-start gap-3 rounded-2xl border border-l-4 border-red-200 border-l-red-600 bg-red-50 p-4">
              <AlertTriangle class="mt-0.5 size-5 shrink-0 text-red-600" />
              <p class="text-sm leading-relaxed text-red-800">
                {formatWarning}
              </p>
            </div>
          </div>
        </Reveal>

        {/* Important rules */}
        <Reveal class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm" delay={80}>
          <h3 class="font-serif text-2xl">{rulesTitle}</h3>
          <ul class="mt-6 space-y-4">
            {rules.map((rule) => (
              <li class="flex items-start gap-3">
                <span class="bg-primary mt-2 size-1.5 shrink-0 rounded-full"></span>
                <span class="text-foreground/80 text-sm leading-relaxed">
                  {rule}
                </span>
              </li>
            ))}
          </ul>
        </Reveal>
      </div>
    </div>
  </div>
</section>
