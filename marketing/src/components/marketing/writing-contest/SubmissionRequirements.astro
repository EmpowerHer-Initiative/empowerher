---
// Ports components/marketing/writing-contest/submission-requirements.tsx
import Reveal from "../home/Reveal.astro";
import AlertTriangle from "../../icons/AlertTriangle.astro";
import {
  Text,
  Heading2,
  Heading3,
  Group,
  Item,
} from "@alisamadiillc/cms-bridge/components";

interface Props {
  eyebrow: string;
  title: string;
  formatTitle: string;
  formatOptions: { title: string; description: string }[];
  formatWarning: string;
  rulesTitle: string;
  rules: string[];
}
const {
  eyebrow,
  title,
  formatTitle,
  formatOptions,
  formatWarning,
  rulesTitle,
  rules,
} = Astro.props;
---

<section class="bg-foreground/[0.025] py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-5xl">
      <Reveal>
        <Text
          as="p"
          class="text-primary text-xs font-semibold tracking-[0.3em] uppercase"
          field={"submissionRequirements.eyebrow"}
          value={eyebrow}
        />
        <Heading2
          class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl"
          field={"submissionRequirements.title"}
          value={title}
        />
      </Reveal>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {/* Format options */}
        <Reveal
          class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm"
        >
          <Heading3
            class="font-serif text-2xl"
            field={"submissionRequirements.formatTitle"}
            value={formatTitle}
          />
          {
            /* not Group/Item-wrapped: this container mixes the mapped formatOptions with a static formatWarning sibling under `space-y-4`; wrapping only the map would disturb the sibling-margin spacing */
          }
          <div class="mt-6 space-y-4">
            {
              formatOptions.map((option, i) => (
                <div class="bg-muted/60 rounded-2xl p-6">
                  <Text
                    as="p"
                    class="text-foreground text-lg font-semibold"
                    field={`submissionRequirements.formatOptions.${i}.title`}
                    value={option.title}
                  />
                  <Text
                    as="p"
                    class="text-muted-foreground mt-2 text-sm leading-relaxed"
                    field={`submissionRequirements.formatOptions.${i}.description`}
                    value={option.description}
                  />
                </div>
              ))
            }
            <div
              class="flex items-start gap-3 rounded-2xl border border-l-4 border-red-200 border-l-red-600 bg-red-50 p-4"
            >
              <AlertTriangle class="mt-0.5 size-5 shrink-0 text-red-600" />
              <Text
                as="p"
                class="text-sm leading-relaxed text-red-800"
                field={"submissionRequirements.formatWarning"}
                value={formatWarning}
              />
            </div>
          </div>
        </Reveal>

        {/* Important rules */}
        <Reveal
          class="border-border/60 bg-background rounded-3xl border p-8 shadow-sm"
          delay={80}
        >
          <Heading3
            class="font-serif text-2xl"
            field={"submissionRequirements.rulesTitle"}
            value={rulesTitle}
          />
          <Group
            field={"submissionRequirements.rules"}
            as="ul"
            class="mt-6 space-y-4"
          >
            {
              rules.map((rule, i) => (
                <Item index={i} as="li" class="flex items-start gap-3">
                  <span class="bg-primary mt-2 size-1.5 shrink-0 rounded-full" />
                  <Text
                    as="span"
                    class="text-foreground/80 text-sm leading-relaxed"
                    field={`submissionRequirements.rules.${i}`}
                    value={rule}
                  />
                </Item>
              ))
            }
          </Group>
        </Reveal>
      </div>
    </div>
  </div>
</section>
