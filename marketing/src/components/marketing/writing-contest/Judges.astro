---
// Ports components/marketing/writing-contest/judges.tsx
import Reveal from "../home/Reveal.astro";

interface Props {
  eyebrow: string;
  title: string;
  items: { name: string; description: string; image: string }[];
  thankYou: string;
  sponsorsText: string;
  sponsorLogos: { src: string; alt: string }[];
}
const { eyebrow, title, items, thankYou, sponsorsText, sponsorLogos } =
  Astro.props;
---
<section class="bg-foreground/[0.025] py-28 md:py-40">
  <div class="container">
    <div class="mx-auto max-w-6xl">
      <Reveal>
        <p class="text-primary text-xs font-semibold tracking-[0.3em] uppercase">
          {eyebrow}
        </p>
        <h2 class="mt-5 font-serif text-4xl leading-[1.1] md:text-5xl">
          {title}
        </h2>
      </Reveal>

      <div class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {items.map((judge, i) => (
          <Reveal delay={(i % 3) * 80}>
            <div class="aspect-square overflow-hidden rounded-2xl">
              <img
                src={judge.image}
                alt={judge.name}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <h3 class="mt-5 font-serif text-2xl">{judge.name}</h3>
            <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
              {judge.description}
            </p>
          </Reveal>
        ))}
      </div>

      {/* Thank you + sponsors */}
      <Reveal class="mt-20 space-y-10">
        <p class="text-muted-foreground mx-auto max-w-2xl text-center text-base leading-relaxed font-medium md:text-lg">
          {thankYou}
        </p>
        <div class="border-border/60 bg-background rounded-3xl border p-10 text-center shadow-sm md:p-14">
          <p class="mx-auto max-w-3xl font-serif text-xl leading-relaxed md:text-2xl">
            {sponsorsText}
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
            <div class="bg-muted/50 size-56 overflow-hidden rounded-2xl">
              <img
                src={sponsorLogos[0].src}
                alt={sponsorLogos[0].alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="bg-background border-border/60 flex w-56 items-center justify-center overflow-hidden rounded-2xl border p-4">
              <img
                src={sponsorLogos[1].src}
                alt={sponsorLogos[1].alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain"
              />
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
