    "collections": [
      {
        "name": "hervoice-stories",
        "label": "HerVoice Stories",
        "path": "_collections/hervoice",
        "route": "/hervoice/{slug}",
        "fields": [
          {
            "name": "title",
            "type": "string",
            "required": true,
            "label": "Title"
          },
          {
            "name": "description",
            "type": "text",
            "label": "Description"
          },
          {
            "name": "image",
            "type": "image",
            "required": true,
            "label": "Cover image"
          },
          {
            "name": "imageAlt",
            "type": "string",
            "label": "Image alt / caption"
          },
          {
            "name": "imageCredit",
            "type": "string",
            "label": "Image credit"
          },
          {
            "name": "date",
            "type": "date",
            "required": true,
            "label": "Date"
          },
          {
            "name": "hideFromListing",
            "type": "boolean",
            "label": "Hide from the HerVoice listing"
          },
          {
            "name": "authorName",
            "type": "string",
            "label": "Author name"
          },
          {
            "name": "authorPosition",
            "type": "string",
            "label": "Author position"
          },
          {
            "name": "authorBio",
            "type": "text",
